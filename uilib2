	local manifestText = nil
	local manifestResponse = RequestRaw(base .. "frames.txt")
	if manifestResponse and type(manifestResponse.Body) == "string" and #manifestResponse.Body > 8 then
		manifestText = manifestResponse.Body
	end
	-- ağ yoksa diskteki kopyayı kullan
	if not manifestText then
		local readFileCached = ExecutorFn("readfile")
		if readFileCached then
			local okRead, data = pcall(readFileCached, dir .. "/frames.txt")
			if okRead and type(data) == "string" and #data > 8 then
				manifestText = data
			end
		end
	end
	if not manifestText then
		return nil, "frames.txt indirilemedi"
	end
	local meta = ParseFramesManifest(manifestText)
	if not meta then return nil, "frames.txt geçersiz" end
	-- sonraki çevrimdışı açılışlar için diske de yaz
	if ExecutorFn("writefile") then
		pcall(ExecutorFn("writefile"), dir .. "/frames.txt", manifestText)
	end

	if not writeFile or not getCustomAsset then
		return nil, "Executor writefile/getcustomasset desteklemiyor"
	end

	EnsureFolder(dir .. "/x")
	meta.assets = {}
	local totalBytes = 0

	for index = 1, meta.atlas do
		local name = string.format("atlas_%02d.jpg", index)
		local path = dir .. "/" .. name
		local body = nil

		-- önbellek: dosya zaten varsa tekrar indirme
		local cached = false
		if isFile and readFile then
			local okFile, exists = pcall(isFile, path)
			if okFile and exists then
				local okRead, data = pcall(readFile, path)
				if okRead and type(data) == "string" and #data > 2000 then
					body = data
					cached = true
				end
			end
		end

		if not body then
			local response = RequestRaw(base .. name)
			if not response or type(response.Body) ~= "string" or #response.Body < 2000 then
				return nil, name .. " indirilemedi"
			end
			body = response.Body
			local okWrite, writeErr = pcall(writeFile, path, body)
			if not okWrite then
				return nil, name .. " yazılamadı: " .. tostring(writeErr)
			end
		end

		totalBytes = totalBytes + #body
		local okAsset, asset = pcall(getCustomAsset, path)
		if not okAsset or type(asset) ~= "string" or asset == "" then
			return nil, name .. " getcustomasset başarısız"
		end
		meta.assets[index] = asset

		if progressCallback then
			progressCallback(index, meta.atlas, cached and "cached" or "frames")
		end
	end

	meta.bytes = totalBytes
	return meta
end

--- Kareleri (bir kez) indirir ve önbelleğe alır.
function Library:_resolveIntroFrames(progressCallback)
	if self._introFrames then return self._introFrames end
	-- önce gömülü kareler (ağ gerekmez)
	if self.Options.UseEmbeddedFrames ~= false then
		local okEmbed, embedMeta = pcall(self.UnpackEmbeddedFrames, self, progressCallback)
		if okEmbed and type(embedMeta) == "table" then return embedMeta end
	end
	if self._introFramesError then return nil end
	local ok, meta, err = pcall(self.DownloadIntroFrames, self, progressCallback)
	if ok and meta then
		self._introFrames = meta
		self._introFramesError = nil
		return meta
	end
	self._introFramesError = tostring(err or meta or "kareler indirilemedi")
	return nil
end

--- Varsa hazır asset'i, yoksa indirip getcustomasset ile asset'e çevirir.
function Library:_resolveIntroVideo(progressCallback)
	local preset = self.Options.IntroVideo
	if type(preset) == "string" and preset ~= "" then
		return preset
	end
	if self._introVideoAsset ~= nil then
		return self._introVideoAsset or nil
	end

	local getCustomAsset = ExecutorFn("getcustomasset")
	if not getCustomAsset then
		self._introVideoAsset = false
		self._introVideoError = "Executor getcustomasset desteklemiyor  •  arayüz modu"
		return nil
	end

	local okDownload, pathOrError = self:DownloadIntroVideo(progressCallback)
	if not okDownload then
		self._introVideoAsset = false
		self._introVideoError = tostring(pathOrError)
		return nil
	end

	local okAsset, asset = pcall(getCustomAsset, pathOrError)
	if okAsset and type(asset) == "string" and asset ~= "" then
		self._introVideoAsset = asset
		self._introVideoBytes = self._introVideoBytes
		return asset
	end

	self._introVideoAsset = false
	self._introVideoError = "getcustomasset başarısız  •  arayüz modu"
	return nil
end

