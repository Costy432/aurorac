--=============================================================================
local function BuildOptionList(source)
	local result = {}
	if type(source) ~= "table" then return result end
	if #source > 0 then
		for _, item in ipairs(source) do
			result[#result + 1] = item
		end
	else
		local keys = {}
		for key in pairs(source) do
			keys[#keys + 1] = key
		end
		table.sort(keys, function(a, b)
			return tostring(a) < tostring(b)
		end)
		for _, key in ipairs(keys) do
			result[#result + 1] = key
		end
	end
	return result
end

CardAddDropdown = function(card, text, opts, callback)
	opts = opts or {}
	local theme = Library.Theme
	local multi = opts.Multi == true
	local listOptions = BuildOptionList(opts.Options or opts.Items)

	local element = ElementBase(card, text, 34)
	local frame = element.Frame
	element._kind = "dropdown"

	New("TextLabel", {
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, -160, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = tostring(text),
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})

	local field = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 4),
		Size = UDim2.fromOffset(148, 26),
		BackgroundColor3 = theme.Element,
		BackgroundTransparency = 0.3,
		Text = "",
		AutoButtonColor = false,
		Parent = frame,
	})
	Corner(field, 7)
	local fieldStroke = Stroke(field, theme.Stroke, 0.88)

	local valueLabel = New("TextLabel", {
		Position = UDim2.new(0, 9, 0, 0),
		Size = UDim2.new(1, -30, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = "",
		TextColor3 = theme.Muted,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = field,
	})

	local chevron = MakeChevron(field, 9, theme.Muted, "down", 1.5)
	chevron.AnchorPoint = Vector2.new(1, 0.5)
	chevron.Position = UDim2.new(1, -8, 0.5, 0)

	local selected = {}
	local menu = nil
	local outsideConnection = nil
	local popupConnections = {}

	local function trackPopup(connection)
		table.insert(popupConnections, connection)
		return connection
	end

	local function copySelection()
		local copy = {}
		for index, item in ipairs(selected) do
			copy[index] = item
		end
		return copy
	end

	local function isSelected(option)
		for _, item in ipairs(selected) do
			if item == option then return true end
		end
		return false
	end

	local function updateDisplay()
		if #selected == 0 then
			valueLabel.Text = opts.Placeholder or "Seç..."
			valueLabel.TextColor3 = theme.Muted
		elseif multi and #selected > 1 then
			valueLabel.Text = tostring(selected[1]) .. " +" .. tostring(#selected - 1)
			valueLabel.TextColor3 = theme.Text
		else
			valueLabel.Text = tostring(selected[1])
			valueLabel.TextColor3 = theme.Text
		end
	end

	local function closeMenu()
		element._menu = nil
		Library._popups[element] = nil
		if outsideConnection then
			pcall(function() outsideConnection:Disconnect() end)
			outsideConnection = nil
		end
		for _, connection in ipairs(popupConnections) do
			pcall(function() connection:Disconnect() end)
		end
		popupConnections = {}
		local current = menu
		menu = nil
		if current then
			local scale = nil
			pcall(function() scale = current:FindFirstChildOfClass("UIScale") end)
			if scale then Tween(scale, { Scale = 0.96 }, 0.12) end
			Tween(current, { GroupTransparency = 1 }, 0.14)
			task.delay(0.16, function()
				pcall(function() current:Destroy() end)
			end)
		end
		Tween(fieldStroke, { Transparency = 0.88, Color = theme.Stroke }, 0.15)
		Tween(chevron, { Rotation = 0 }, 0.18)
		Tween(field, { BackgroundTransparency = 0.3 }, 0.15)
	end

	local function openMenu()
		if menu then
			closeMenu()
			return
		end
		if not Library._root then return end

		local itemHeight = 28
		local maxVisible = opts.MaxVisible or 6
		local visibleCount = Clamp(#listOptions, 1, maxVisible)
		local searchEnabled = (#listOptions > maxVisible) or (opts.Search == true)
		local menuWidth = math.max(184, field.AbsoluteSize.X)
		local searchArea = searchEnabled and 34 or 8
		local menuHeight = searchArea + visibleCount * itemHeight + 10

		local group = New("CanvasGroup", {
			Name = "DropdownMenu",
			Size = UDim2.fromOffset(menuWidth, menuHeight),
			BackgroundTransparency = 1,
			GroupTransparency = 1,
			ZIndex = 800,
			Parent = Library._root,
		})

		local panel = New("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = theme.Panel,
			BackgroundTransparency = 0.02,
			BorderSizePixel = 0,
			Parent = group,
		})
		Corner(panel, 10)
		Stroke(panel, theme.Stroke, 0.78, 1.2)
		New("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(24, 28, 40), Color3.fromRGB(14, 17, 24)),
			Rotation = 90,
			Parent = panel,
		})

		local query = ""
		local searchBox = nil
		if searchEnabled then
			local searchShell = New("Frame", {
				Position = UDim2.new(0, 8, 0, 8),
				Size = UDim2.new(1, -16, 0, 22),
				BackgroundColor3 = theme.Element,
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
				Parent = panel,
			})
			Corner(searchShell, 6)
			searchBox = New("TextBox", {
				Position = UDim2.new(0, 8, 0, 0),
				Size = UDim2.new(1, -14, 1, 0),
				BackgroundTransparency = 1,
				Font = Enum.Font.Gotham,
				Text = "",
				PlaceholderText = "Ara...",
				PlaceholderColor3 = theme.Muted,
				TextColor3 = theme.Text,
				TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = false,
				Parent = searchShell,
			})
		end

		local list = New("ScrollingFrame", {
			Position = UDim2.new(0, 6, 0, searchArea),
			Size = UDim2.new(1, -12, 1, -searchArea - 4),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = theme.Accent,
			ScrollBarImageTransparency = 0.5,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			CanvasSize = UDim2.new(0, 0, 0, 0),
			Parent = panel,
		})
		local listLayout = List(list, 2)

		local rebuild

		local function choose(option)
			if multi then
				if isSelected(option) then
					for index, item in ipairs(selected) do
						if item == option then
							table.remove(selected, index)
							break
						end
					end
				else
					table.insert(selected, option)
				end
				updateDisplay()
				rebuild()
				SafeCallback(callback, copySelection(), option)
			else
				selected = { option }
				updateDisplay()
				SafeCallback(callback, option, option)
				closeMenu()
			end
		end

		function rebuild()
			for _, child in ipairs(list:GetChildren()) do
				if child:IsA("TextButton") then
					child:Destroy()
				end
			end

			local shown = 0
			for _, option in ipairs(listOptions) do
				local optionText = tostring(option)
				if query == "" or string.find(string.lower(optionText), string.lower(query), 1, true) then
					shown = shown + 1
					local active = isSelected(option)

					local itemButton = New("TextButton", {
						LayoutOrder = shown,
						Size = UDim2.new(1, 0, 0, 26),
						BackgroundColor3 = theme.Accent,
						BackgroundTransparency = active and 0.86 or 1,
						Text = "",
						AutoButtonColor = false,
						Parent = list,
					})
					Corner(itemButton, 6)

					New("TextLabel", {
						Position = UDim2.new(0, 9, 0, 0),
						Size = UDim2.new(1, -30, 1, 0),
						BackgroundTransparency = 1,
						Font = Enum.Font.Gotham,
						Text = optionText,
						TextColor3 = active and theme.Text or theme.SubText,
						TextSize = 11,
						TextXAlignment = Enum.TextXAlignment.Left,
						TextTruncate = Enum.TextTruncate.AtEnd,
						Parent = itemButton,
					})

					if active then
						local check = Icons.Render(itemButton, "check", theme.Accent2, 12)
						check.AnchorPoint = Vector2.new(1, 0.5)
						check.Position = UDim2.new(1, -8, 0.5, 0)
					end

					itemButton.MouseEnter:Connect(function()
						if not isSelected(option) then
							Tween(itemButton, { BackgroundColor3 = theme.ElementHover, BackgroundTransparency = 0.85 }, 0.12)
						end
					end)
					itemButton.MouseLeave:Connect(function()
						if not isSelected(option) then
							Tween(itemButton, { BackgroundTransparency = 1 }, 0.12)
						end
					end)
					itemButton.MouseButton1Click:Connect(function()
						choose(option)
					end)
				end
			end

			list.CanvasSize = UDim2.new(0, 0, 0, math.max(shown * itemHeight, 8))
		end

		rebuild()

		if searchBox then
			trackPopup(Connect(searchBox:GetPropertyChangedSignal("Text"), function()
				query = searchBox.Text or ""
				rebuild()
			end))
			task.defer(function()
				pcall(function() searchBox:CaptureFocus() end)
			end)
		end

		-- Konum
		local rootPosition = Library._root.AbsolutePosition
		local fieldPosition = field.AbsolutePosition
		local fieldSize = field.AbsoluteSize
		local viewportNow = Viewport()
		local menuX = fieldPosition.X - rootPosition.X
		local menuY = (fieldPosition.Y - rootPosition.Y) + fieldSize.Y + 6

		if menuX + menuWidth > viewportNow.X - 10 then
			menuX = viewportNow.X - menuWidth - 10
		end
		if menuY + menuHeight > viewportNow.Y - 10 then
			menuY = (fieldPosition.Y - rootPosition.Y) - menuHeight - 6
		end
		menuX = math.max(8, menuX)
		menuY = math.max(8, menuY)

		group.Position = UDim2.fromOffset(math.floor(menuX), math.floor(menuY))
		local scale = New("UIScale", { Scale = 0.96, Parent = group })
		Tween(scale, { Scale = 1 }, 0.16, EASE.Back, DIR.Out)
		Tween(group, { GroupTransparency = 0 }, 0.15, EASE.Quad)
		Tween(chevron, { Rotation = 180 }, 0.2)
		Tween(fieldStroke, { Transparency = 0.4, Color = theme.Accent }, 0.15)

		menu = group
		element._menu = group
		Library._popups[element] = closeMenu

		outsideConnection = Connect(UserInputService.InputBegan, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			local position = input.Position
			local groupPos = group.AbsolutePosition
			local groupSize = group.AbsoluteSize
			local insideGroup = position.X >= groupPos.X and position.X <= groupPos.X + groupSize.X
				and position.Y >= groupPos.Y and position.Y <= groupPos.Y + groupSize.Y
			local fieldPos = field.AbsolutePosition
			local fieldSizeNow = field.AbsoluteSize
			local insideField = position.X >= fieldPos.X and position.X <= fieldPos.X + fieldSizeNow.X
				and position.Y >= fieldPos.Y and position.Y <= fieldPos.Y + fieldSizeNow.Y
			if not insideGroup and not insideField then
				closeMenu()
			end
		end)
	end

	field.MouseEnter:Connect(function()
		if not menu then
			Tween(fieldStroke, { Transparency = 0.7 }, 0.15)
		end
	end)
	field.MouseLeave:Connect(function()
		if not menu then
			Tween(fieldStroke, { Transparency = 0.88 }, 0.15)
		end
	end)

	field.MouseButton1Click:Connect(function()
		openMenu()
	end)

	-- Başlangıç değerleri
	local defaults = opts.Default or opts.Value
	if defaults ~= nil then
		if type(defaults) == "table" then
			for _, item in ipairs(defaults) do
				table.insert(selected, item)
			end
		else
			table.insert(selected, defaults)
		end
	end
	updateDisplay()

	function element:Set(newValue)
		selected = {}
		if type(newValue) == "table" then
			for _, item in ipairs(newValue) do
				table.insert(selected, item)
			end
		elseif newValue ~= nil then
			table.insert(selected, newValue)
		end
		updateDisplay()
		if multi then
			SafeCallback(callback, copySelection(), selected[1])
		else
			SafeCallback(callback, selected[1], selected[1])
		end
	end

	function element:Get()
		if multi then
			return copySelection()
		end
		return selected[1]
	end

	function element:Refresh(newOptions)
		listOptions = BuildOptionList(newOptions)
		local filtered = {}
		for _, item in ipairs(selected) do
			for _, option in ipairs(listOptions) do
				if option == item then
					table.insert(filtered, item)
					break
				end
			end
		end
		selected = filtered
		updateDisplay()
		if menu then
			rebuild()
		end
	end

	element._options = listOptions
	local optionNames = {}
	for _, option in ipairs(listOptions) do
		optionNames[#optionNames + 1] = tostring(option)
	end
	if #optionNames > 0 then
		element._search = element._search .. " " .. table.concat(optionNames, " ")
	end

	local flag = opts.Flag or tostring(text)
	if flag then
		Library._flags[flag] = element
	end

	card:_refresh()
	return element
end

