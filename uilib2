Library._propertyWarnings = {}

local function WarnOnce(key, err)
	if Library._propertyWarnings[key] then return end
	Library._propertyWarnings[key] = true
	warn("[AuroraUI] '" .. tostring(key) .. "' ayarlanamadı: " .. tostring(err))
end

local function New(className, props, parent)
	local ok, inst = pcall(Instance.new, className)
	if not ok or not inst then
		warn("[AuroraUI] Instance.new('" .. tostring(className) .. "') başarısız: " .. tostring(inst))
		-- En kötü ihtimalle Frame'e düş (kütüphane tamamen çökmesin)
		local fallbackOk, fallback = pcall(Instance.new, "Frame")
		inst = fallbackOk and fallback or nil
		if not inst then return nil end
	end

	local parentRef = parent
	if props then
		for key, value in pairs(props) do
			if key == "Parent" then
				parentRef = value
			else
				local assigned, err = pcall(function()
					inst[key] = value
				end)
				if not assigned then
					WarnOnce(key, err)
				end
			end
		end
	end
	if parentRef then
		local parented, err = pcall(function()
			inst.Parent = parentRef
		end)
		if not parented then
			WarnOnce("Parent", err)
		end
	end
	return inst
end

local function Corner(inst, radius)
	return New("UICorner", { CornerRadius = UDim.new(0, radius or 8), Parent = inst })
end

local function PillCorner(inst)
	return New("UICorner", { CornerRadius = UDim.new(1, 0), Parent = inst })
end

local function Stroke(inst, color, transparency, thickness)
	return New("UIStroke", {
		Color = color or Library.Theme.Stroke,
		Transparency = transparency or 0.9,
		Thickness = thickness or 1,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = inst,
	})
end

local function AccentGradient(inst, rotation, transparency)
	if transparency == nil then transparency = 0 end
	return New("UIGradient", {
		Color = ColorSequence.new(Library.Theme.Accent, Library.Theme.Accent2),
		Rotation = rotation or 0,
		Transparency = NumberSequence.new(transparency),
		Parent = inst,
	})
end

local function List(parent, padding, horizontal, halign, valign)
	return New("UIListLayout", {
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Padding = UDim.new(0, padding or 0),
		Parent = parent,
	})
end

local function Padding(parent, all, top, bottom, left, right)
	if all then
		top, bottom, left, right = all, all, all, all
	end
	return New("UIPadding", {
		PaddingTop = UDim.new(0, top or 0),
		PaddingBottom = UDim.new(0, bottom or 0),
		PaddingLeft = UDim.new(0, left or 0),
		PaddingRight = UDim.new(0, right or 0),
		Parent = parent,
	})
end

local function Tween(inst, props, time, style, dir)
	if not inst then return nil end
	local info = TweenInfo.new(time or 0.18, style or EASE.Quint, dir or DIR.Out)
	local ok, tw = pcall(function() return TweenService:Create(inst, info, props) end)
	if ok and tw then
		tw:Play()
		table.insert(Library._tweens, tw)
		if #Library._tweens > 400 then
			table.remove(Library._tweens, 1)
		end
		return tw
	end
	return nil
end

local function Connect(signal, fn)
	local connection = signal:Connect(fn)
	local bucket = Library._bucket
	if bucket then
		table.insert(bucket, connection)
	else
		table.insert(Library._connections, connection)
	end
	return connection
end

local function Viewport()
	local camera = workspace and workspace.CurrentCamera
	if camera then return camera.ViewportSize end
	return Vector2.new(1280, 720)
end

local function Clamp(value, minValue, maxValue)
	if value < minValue then return minValue end
	if value > maxValue then return maxValue end
	return value
end

local function RoundTo(value, step)
	if not step or step <= 0 then return value end
	return math.floor(value / step + 0.5) * step
end

local function DecimalsOf(step)
	step = step or 1
	if step >= 1 then return 0 end
	local text = string.format("%.4f", step)
	local _, dotIndex = string.find(text, "%.")
	if not dotIndex then return 0 end
	local decimals = 0
	for i = dotIndex + 1, #text do
		local ch = string.sub(text, i, i)
		if ch == "0" then break end
		decimals = decimals + 1
	end
	return math.max(0, decimals)
end

local function FormatNumber(value, decimals)
	decimals = decimals or 0
	if decimals <= 0 then
		return tostring(math.floor(value + 0.5))
	end
	local text = string.format("%." .. tostring(decimals) .. "f", value)
	return text
end

local function ColorToHex(color)
	local r = math.floor(color.R * 255 + 0.5)
	local g = math.floor(color.G * 255 + 0.5)
	local b = math.floor(color.B * 255 + 0.5)
	return string.format("#%02X%02X%02X", r, g, b)
end

local function SafeCallback(fn, ...)
	if type(fn) ~= "function" then return end
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[AuroraUI] Callback hatası: " .. tostring(err))
	end
end

local atan2 = math.atan2 or function(y, x) return math.atan(y, x) end

