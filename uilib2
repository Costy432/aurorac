local function BuildDownloadScreen(parent, unit)
	local theme = Library.Theme

	local group = New("CanvasGroup", {
		Name = "DownloadScreen",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(5, 7, 11),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		GroupTransparency = 0,
		Parent = parent,
	})

	-- arka plan ışıkları
	local glowLeft = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.28, 0.35),
		Size = UDim2.fromScale(0.55, 0.55),
		BackgroundColor3 = theme.Accent,
		BackgroundTransparency = 0.9,
		BorderSizePixel = 0,
		Parent = group,
	})
	PillCorner(glowLeft)
	local glowRight = glowLeft:Clone()
	glowRight.Position = UDim2.fromScale(0.74, 0.68)
	glowRight.BackgroundColor3 = theme.Accent2
	glowRight.Parent = group

	local pulseInfo = TweenInfo.new(2.4, EASE.Sine, DIR.InOut, -1, true)
	pcall(function()
		TweenService:Create(glowLeft, pulseInfo, { BackgroundTransparency = 0.82, Size = UDim2.fromScale(0.62, 0.62) }):Play()
		TweenService:Create(glowRight, pulseInfo, { BackgroundTransparency = 0.82, Size = UDim2.fromScale(0.62, 0.62) }):Play()
	end)

	-- logo
	local logo = New("Frame", {
		Name = "Logo",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(74 * unit, 74 * unit),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Parent = group,
	})
	Corner(logo, 22 * unit)
	AccentGradient(logo, 40)
	New("UIStroke", {
		Color = Color3.fromRGB(255, 255, 255),
		Transparency = 0.75,
		Thickness = 1.5,
		Parent = logo,
	})
	New("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Text = "A",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextSize = math.floor(34 * unit),
		Parent = logo,
	})

	local spinInfo = TweenInfo.new(2.2, EASE.Linear, DIR.Out, -1)
	local logoGlow = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1.35, 1.35),
		BackgroundTransparency = 1,
		Parent = logo,
	})
	PillCorner(logoGlow)
	New("UIStroke", {
		Color = theme.Accent2,
		Transparency = 0.35,
		Thickness = 2,
		Parent = logoGlow,
	})
	pcall(function()
		TweenService:Create(logoGlow, spinInfo, { Rotation = 360 }):Play()
	end)

	-- başlık
	New("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.new(1, 0, 0, 30 * unit),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		Text = "AURORA UI",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextSize = math.floor(24 * unit),
		Parent = group,
	})

	New("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.4, 34 * unit),
		Size = UDim2.new(1, 0, 0, 16 * unit),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = "SİNEMATİK ARAYÜZ YÜKLENİYOR",
		TextColor3 = Color3.fromRGB(150, 162, 190),
		TextSize = math.floor(10 * unit),
		Parent = group,
	})

	-- ilerleme çubuğu
	local barWidth = math.floor(430 * unit)
	local bar = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 34 * unit),
		Size = UDim2.fromOffset(barWidth, 6 * unit),
		BackgroundColor3 = Color3.fromRGB(30, 36, 50),
		BorderSizePixel = 0,
		Parent = group,
	})
	PillCorner(bar)

	local fill = New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Parent = bar,
	})
	PillCorner(fill)
	AccentGradient(fill, 0)

	local shine = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.35, 1),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Parent = fill,
	})
	PillCorner(shine)
	pcall(function()
		TweenService:Create(shine, TweenInfo.new(1.1, EASE.Sine, DIR.InOut, -1, true), {
			Position = UDim2.fromScale(-0.2, 0.5),
		}):Play()
	end)

	local percentLabel = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(0.5, barWidth / 2, 0.5, 18 * unit),
		Size = UDim2.fromOffset(80 * unit, 16 * unit),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "0%",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextSize = math.floor(12 * unit),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = group,
	})

	local statusLabel = New("TextLabel", {
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0.5, -barWidth / 2, 0.5, 18 * unit),
		Size = UDim2.fromOffset(barWidth - 90 * unit, 16 * unit),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = "Bağlantı kuruluyor...",
		TextColor3 = Color3.fromRGB(170, 182, 205),
		TextSize = math.floor(11 * unit),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = group,
	})

	local metaLabel = New("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 56 * unit),
		Size = UDim2.new(1, 0, 0, 14 * unit),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = "intro.mp4  →  workspace/AuroraUI/",
		TextColor3 = Color3.fromRGB(110, 122, 148),
		TextSize = math.floor(10 * unit),
		Parent = group,
	})

	-- köşe bilgileri
	New("TextLabel", {
		Position = UDim2.fromOffset(26 * unit, 22 * unit),
		Size = UDim2.fromOffset(220 * unit, 14 * unit),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = "AURORA UI  •  " .. Library.Version,
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextTransparency = 0.5,
		TextSize = math.floor(10 * unit),
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = group,
	})

	New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -26 * unit, 0, 22 * unit),
		Size = UDim2.fromOffset(70 * unit, 18 * unit),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.9,
		Font = Enum.Font.GothamBold,
		Text = "4K",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextSize = math.floor(10 * unit),
		Parent = group,
	})
	local badge = group:GetChildren()
	local lastBadge = badge[#badge]
	if lastBadge then Corner(lastBadge, 5) end

	local hint = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -26 * unit, 1, -26 * unit),
		Size = UDim2.fromOffset(250 * unit, 14 * unit),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = "İndirmeyi atlamak için tıkla",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		TextTransparency = 0.6,
		TextSize = math.floor(10 * unit),
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = group,
	})

	local api = { group = group }

	function api:SetStatus(text)
		statusLabel.Text = tostring(text)
	end

	function api:SetProgress(current, total)
		local ratio = 0
		if total and total > 0 and current and current >= 0 then
			ratio = Clamp(current / total, 0, 1)
		elseif current == -1 then
			ratio = 1
		end
		Tween(fill, { Size = UDim2.fromScale(ratio, 1) }, 0.25, EASE.Quad)
		percentLabel.Text = tostring(math.floor(ratio * 100 + 0.5)) .. "%"
		if total and total > 0 then
			metaLabel.Text = string.format("%.1f MB / %.1f MB  →  workspace/AuroraUI/intro.mp4",
				current / 1048576, total / 1048576)
		end
	end

	function api:SetHint(text)
		hint.Text = tostring(text)
	end

	return api
end

