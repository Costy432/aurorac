-- Eski Roblox sürümlerinde / kısıtlı executor'larda bulunmayan enum değerleri
-- yüzünden script çökmesin diye tüm enumlar kontrollü okunur.
--=============================================================================
local function ResolveEnum(enumName, itemName, fallback)
	local okEnum, enumType = pcall(function() return Enum[enumName] end)
	if okEnum and enumType then
		local okItem, item = pcall(function() return enumType[itemName] end)
		if okItem and item ~= nil then
			return item
		end
	end
	return fallback
end

local EASE = {
	Linear = ResolveEnum("EasingStyle", "Linear"),
	Sine   = ResolveEnum("EasingStyle", "Sine", ResolveEnum("EasingStyle", "Linear")),
	Quad   = ResolveEnum("EasingStyle", "Quad", ResolveEnum("EasingStyle", "Linear")),
	Quint  = ResolveEnum("EasingStyle", "Quint", ResolveEnum("EasingStyle", "Quad", ResolveEnum("EasingStyle", "Linear"))),
	Back   = ResolveEnum("EasingStyle", "Back", ResolveEnum("EasingStyle", "Quad", ResolveEnum("EasingStyle", "Linear"))),
	-- "Expo" DİYE BİR DEĞER YOK; doğrusu "Exponential". Yoksa Quint'e düşer.
	Snappy = ResolveEnum("EasingStyle", "Exponential",
		ResolveEnum("EasingStyle", "Quint", ResolveEnum("EasingStyle", "Quad", ResolveEnum("EasingStyle", "Linear")))),
}
local DIR = {
	In    = ResolveEnum("EasingDirection", "In"),
	Out   = ResolveEnum("EasingDirection", "Out"),
	InOut = ResolveEnum("EasingDirection", "InOut"),
}

