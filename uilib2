CardAddKeybind = function(card, text, opts, callback)
	opts = opts or {}
	local theme = Library.Theme

	local element = ElementBase(card, text, 34)
	local frame = element.Frame
	element._kind = "keybind"

	New("TextLabel", {
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, -110, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = tostring(text),
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})

	local pill = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 4),
		Size = UDim2.fromOffset(102, 26),
		BackgroundColor3 = theme.Element,
		BackgroundTransparency = 0.3,
		Text = "",
		AutoButtonColor = false,
		Parent = frame,
	})
	Corner(pill, 7)
	local pillStroke = Stroke(pill, theme.Stroke, 0.88)

	local keyLabel = New("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = "",
		TextColor3 = theme.Text,
		TextSize = 11,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = pill,
	})

	local currentKey = opts.Default
	local listening = false
	local captureConnection = nil

	local function display()
		if listening then
			keyLabel.Text = "Tuş bekleniyor..."
			keyLabel.TextColor3 = theme.Accent
		elseif currentKey then
			keyLabel.Text = tostring(currentKey.Name)
			keyLabel.TextColor3 = theme.Text
		else
			keyLabel.Text = "Atanmadı"
			keyLabel.TextColor3 = theme.Muted
		end
	end

	local function stopListening()
		listening = false
		if Library._keybindTarget == element then
			Library._keybindTarget = nil
		end
		if captureConnection then
			pcall(function() captureConnection:Disconnect() end)
			captureConnection = nil
		end
		Tween(pillStroke, { Transparency = 0.88, Color = theme.Stroke }, 0.15)
		Tween(pill, { BackgroundTransparency = 0.3 }, 0.15)
	end

	local function finish(key, cancelled)
		stopListening()
		if not cancelled then
			currentKey = key
			display()
			SafeCallback(callback, currentKey)
		else
			display()
		end
	end

	local function startListening()
		if listening then return end
		listening = true
		Library._keybindTarget = element
		display()
		Tween(pillStroke, { Transparency = 0.35, Color = theme.Accent }, 0.15)
		Tween(pill, { BackgroundTransparency = 0.15 }, 0.15)

		if captureConnection then
			pcall(function() captureConnection:Disconnect() end)
		end
		captureConnection = Connect(UserInputService.InputBegan, function(input, gameProcessed)
			if not listening then return end
			if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
			if input.KeyCode == Enum.KeyCode.Escape then
				finish(nil, true)
			elseif input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete then
				finish(nil, false)
			else
				finish(input.KeyCode, false)
			end
		end)
	end

	pill.MouseButton1Click:Connect(function()
		if listening then
			finish(nil, true)
		else
			startListening()
		end
	end)

	element._capture = function(self, keyCode)
		if keyCode == Enum.KeyCode.Escape then
			finish(nil, true)
		else
			finish(keyCode, false)
		end
	end

	function element:Set(key)
		currentKey = key
		display()
	end

	function element:Get()
		return currentKey
	end

	display()

	local flag = opts.Flag or tostring(text)
	if flag then
		Library._flags[flag] = element
	end

	card:_refresh()
	return element
end

--=============================================================================
-- ELEMAN: COLOR PICKER (HSV popup)
--=============================================================================
CardAddColorPicker = function(card, text, opts, callback)
	opts = opts or {}
	local theme = Library.Theme

	local element = ElementBase(card, text, 34)
	local frame = element.Frame
	element._kind = "colorpicker"

	New("TextLabel", {
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, -120, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = tostring(text),
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})

	local button = New("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 3),
		Size = UDim2.fromOffset(112, 28),
		BackgroundColor3 = theme.Element,
		BackgroundTransparency = 0.3,
		Text = "",
		AutoButtonColor = false,
		Parent = frame,
	})
	Corner(button, 7)
	local buttonStroke = Stroke(button, theme.Stroke, 0.88)

	local currentColor = opts.Default or Color3.fromRGB(139, 92, 246)
	local h, s, v = Color3.toHSV(currentColor)

	local swatch = New("Frame", {
		Position = UDim2.new(0, 7, 0.5, -8),
		Size = UDim2.fromOffset(16, 16),
		BackgroundColor3 = currentColor,
		BorderSizePixel = 0,
		Parent = button,
	})
	PillCorner(swatch)
	New("UIStroke", {
		Color = Color3.fromRGB(255, 255, 255),
		Transparency = 0.72,
		Parent = swatch,
	})

	local hexLabel = New("TextLabel", {
		Position = UDim2.new(0, 29, 0, 0),
		Size = UDim2.new(1, -34, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = ColorToHex(currentColor),
		TextColor3 = theme.Text,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = button,
	})

	local popup = nil
	local popupRefs = {}
	local popupConnections = {}

	local function updatePopupVisuals()
		if not popup or not popup.Parent then return end
		popupRefs.svBase.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
		popupRefs.svMarker.Position = UDim2.fromScale(s, 1 - v)
		popupRefs.hueMarker.Position = UDim2.fromScale(h, 0.5)
		popupRefs.hexText.Text = ColorToHex(currentColor)
		popupRefs.hexText.TextColor3 = theme.Text
	end

	local function pushColor(trigger)
		currentColor = Color3.fromHSV(h, s, v)
		swatch.BackgroundColor3 = currentColor
		hexLabel.Text = ColorToHex(currentColor)
		updatePopupVisuals()
		if trigger then
			SafeCallback(callback, currentColor)
		end
	end

	local function closePopup()
		Library._popups[element] = nil
		for _, connection in ipairs(popupConnections) do
			pcall(function() connection:Disconnect() end)
		end
		popupConnections = {}
		local current = popup
		popup = nil
		if current then
			Tween(current, { GroupTransparency = 1 }, 0.14)
			task.delay(0.16, function()
				pcall(function() current:Destroy() end)
			end)
		end
		Tween(buttonStroke, { Transparency = 0.88, Color = theme.Stroke }, 0.15)
	end

	local function openPopup()
		if popup then
			closePopup()
			return
		end
		if not Library._root then return end

		local group = New("CanvasGroup", {
			Name = "ColorPicker",
			Size = UDim2.fromOffset(190, 176),
			BackgroundTransparency = 1,
			GroupTransparency = 1,
			ZIndex = 810,
			Parent = Library._root,
		})

		local panel = New("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = theme.Panel,
			BackgroundTransparency = 0.02,
			BorderSizePixel = 0,
			Parent = group,
		})
		Corner(panel, 10)
		Stroke(panel, theme.Stroke, 0.78, 1.2)
		New("UIGradient", {
			Color = ColorSequence.new(Color3.fromRGB(24, 28, 40), Color3.fromRGB(14, 17, 24)),
			Rotation = 90,
			Parent = panel,
		})

		local svFrame = New("Frame", {
			Position = UDim2.new(0, 10, 0, 10),
			Size = UDim2.fromOffset(170, 100),
			BackgroundColor3 = Color3.fromHSV(h, 1, 1),
			BorderSizePixel = 0,
			ClipsDescendants = true,
			Parent = panel,
		})
		Corner(svFrame, 8)

		local whiteOverlay = New("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BorderSizePixel = 0,
			Parent = svFrame,
		})
		New("UIGradient", {
			Transparency = NumberSequence.new(0, 1),
			Parent = whiteOverlay,
		})

		local blackOverlay = New("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BorderSizePixel = 0,
			Parent = svFrame,
		})
		New("UIGradient", {
			Transparency = NumberSequence.new(1, 0),
			Rotation = 90,
			Parent = blackOverlay,
		})

		local svMarker = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(s, 1 - v),
			Size = UDim2.fromOffset(13, 13),
			BackgroundTransparency = 1,
			ZIndex = 5,
			Parent = svFrame,
		})
		PillCorner(svMarker)
		New("UIStroke", {
			Color = Color3.fromRGB(255, 255, 255),
			Thickness = 2,
			Parent = svMarker,
		})

		local hueStrip = New("Frame", {
			Position = UDim2.new(0, 10, 0, 120),
			Size = UDim2.fromOffset(170, 12),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BorderSizePixel = 0,
			Parent = panel,
		})
		Corner(hueStrip, 6)
		local hueStops = {}
		for index = 0, 6 do
			hueStops[#hueStops + 1] = ColorSequenceKeypoint.new(index / 6, Color3.fromHSV(index / 6, 1, 1))
		end
		New("UIGradient", {
			Color = ColorSequence.new(hueStops),
			Parent = hueStrip,
		})

		local hueMarker = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(h, 0.5),
			Size = UDim2.fromOffset(5, 17),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BorderSizePixel = 0,
			ZIndex = 5,
			Parent = hueStrip,
		})
		Corner(hueMarker, 3)
		New("UIStroke", {
			Color = Color3.fromRGB(0, 0, 0),
			Transparency = 0.4,
			Parent = hueMarker,
		})

		local hexText = New("TextLabel", {
			Position = UDim2.new(0, 12, 0, 143),
			Size = UDim2.new(1, -24, 0, 20),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			Text = ColorToHex(currentColor),
			TextColor3 = theme.SubText,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = panel,
		})

		local copyButton = New("TextButton", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -10, 0, 143),
			Size = UDim2.fromOffset(60, 20),
			BackgroundColor3 = theme.Element,
			BackgroundTransparency = 0.35,
			Font = Enum.Font.GothamMedium,
			Text = "Kopyala",
			TextColor3 = theme.SubText,
			TextSize = 10,
			AutoButtonColor = false,
			Parent = panel,
		})
		Corner(copyButton, 6)

		popupRefs = {
			svBase = svFrame,
			svMarker = svMarker,
			hueMarker = hueMarker,
			hexText = hexText,
		}

		local rootPosition = Library._root.AbsolutePosition
		local buttonPosition = button.AbsolutePosition
		local buttonSize = button.AbsoluteSize
		local viewportNow = Viewport()
		local popupWidth = 190
		local popupHeight = 176
		local popupX = (buttonPosition.X - rootPosition.X) + buttonSize.X - popupWidth
		local popupY = (buttonPosition.Y - rootPosition.Y) + buttonSize.Y + 8

		if popupX < 8 then popupX = 8 end
		if popupX + popupWidth > viewportNow.X - 8 then
			popupX = viewportNow.X - popupWidth - 8
		end
		if popupY + popupHeight > viewportNow.Y - 8 then
			popupY = (buttonPosition.Y - rootPosition.Y) - popupHeight - 8
		end
		if popupY < 8 then popupY = 8 end

		group.Position = UDim2.fromOffset(math.floor(popupX), math.floor(popupY))
		local scale = New("UIScale", { Scale = 0.96, Parent = group })
		Tween(scale, { Scale = 1 }, 0.16, EASE.Back, DIR.Out)
		Tween(group, { GroupTransparency = 0 }, 0.15, EASE.Quad)
		Tween(buttonStroke, { Transparency = 0.4, Color = theme.Accent }, 0.15)

		local function updateSV(input)
			local position = svFrame.AbsolutePosition
			local size = svFrame.AbsoluteSize
			s = Clamp((input.Position.X - position.X) / math.max(size.X, 1), 0, 1)
			v = 1 - Clamp((input.Position.Y - position.Y) / math.max(size.Y, 1), 0, 1)
			pushColor(true)
		end

		local function updateHue(input)
			local position = hueStrip.AbsolutePosition
			local size = hueStrip.AbsoluteSize
			h = Clamp((input.Position.X - position.X) / math.max(size.X, 1), 0, 1)
			pushColor(true)
		end

		local function track(connection)
			table.insert(popupConnections, connection)
		end

		track(Connect(svFrame.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				Library._colorDrag = { element = element, mode = "sv" }
				updateSV(input)
			end
		end))

		track(Connect(hueStrip.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				Library._colorDrag = { element = element, mode = "hue" }
				updateHue(input)
			end
		end))

		track(Connect(UserInputService.InputChanged, function(input)
			local drag = Library._colorDrag
			if not drag or drag.element ~= element then return end
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				if drag.mode == "sv" then
					updateSV(input)
				else
					updateHue(input)
				end
			end
		end))

		track(Connect(UserInputService.InputEnded, function(input)
			local drag = Library._colorDrag
			if drag and drag.element == element then
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					Library._colorDrag = nil
				end
			end
		end))

		track(Connect(UserInputService.InputBegan, function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			local position = input.Position
			local groupPos = group.AbsolutePosition
			local groupSize = group.AbsoluteSize
			local insideGroup = position.X >= groupPos.X and position.X <= groupPos.X + groupSize.X
				and position.Y >= groupPos.Y and position.Y <= groupPos.Y + groupSize.Y
			local buttonPos = button.AbsolutePosition
			local buttonSizeNow = button.AbsoluteSize
			local insideButton = position.X >= buttonPos.X and position.X <= buttonPos.X + buttonSizeNow.X
				and position.Y >= buttonPos.Y and position.Y <= buttonPos.Y + buttonSizeNow.Y
			if not insideGroup and not insideButton then
				closePopup()
			end
		end))

		copyButton.MouseButton1Click:Connect(function()
			local text = ColorToHex(currentColor)
			pcall(function()
				if setclipboard then
					setclipboard(text)
					Library:Notify({ Title = "Renk kopyalandı", Content = text, Type = "success", Duration = 2 })
				end
			end)
		end)

		copyButton.MouseEnter:Connect(function()
			Tween(copyButton, { BackgroundTransparency = 0.1, TextColor3 = theme.Text }, 0.12)
		end)
		copyButton.MouseLeave:Connect(function()
			Tween(copyButton, { BackgroundTransparency = 0.35, TextColor3 = theme.SubText }, 0.12)
		end)

		popup = group
		Library._popups[element] = closePopup
	end

	button.MouseEnter:Connect(function()
		if not popup then
			Tween(buttonStroke, { Transparency = 0.7 }, 0.15)
		end
	end)
	button.MouseLeave:Connect(function()
		if not popup then
			Tween(buttonStroke, { Transparency = 0.88 }, 0.15)
		end
	end)
	button.MouseButton1Click:Connect(function()
		openPopup()
	end)

	function element:Set(color)
		if type(color) ~= "table" and type(color) ~= "userdata" then return end
		if color.R == nil or color.G == nil or color.B == nil then return end
		h, s, v = Color3.toHSV(color)
		pushColor(true)
	end

	function element:Get()
		return currentColor
	end

	local flag = opts.Flag or tostring(text)
	if flag then
		Library._flags[flag] = element
	end

	card:_refresh()
	return element
end

