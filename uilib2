	local hasContent = content ~= ""
	local height = hasContent and 70 or 52

	local toast = New("CanvasGroup", {
		Name = "Toast",
		Size = UDim2.new(1, 0, 0, height),
		Position = UDim2.fromOffset(0, 9999),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
