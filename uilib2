	--==========================================================================
	-- LAYOUT / ARAMA
	--==========================================================================
	function windowObject:_relayout(page)
		if not page or not page._frame or not page._frame.Parent then return end

		local sizeNow = page._frame.AbsoluteSize
		local scaleFactor = (baseScale and baseScale > 0) and baseScale or 1
		-- AbsoluteSize ekran pikselidir; kart ölçüleri UIScale'li yerel koordinatta.
		local localWidth = sizeNow.X > 0 and (sizeNow.X / scaleFactor) or 664
		local available = localWidth - 10
		if available < 240 then available = 240 end

		local gap = 10
		local minimumWidth = 286
		local columns = math.floor((available + gap) / (minimumWidth + gap))
		columns = Clamp(columns, 1, 3)
		local columnWidth = math.floor((available - gap * (columns - 1)) / columns)

		-- Önce tüm kartları (gizli olanlar dahil) ölçekle; arama filtresi
		-- görünürlüğü kartın kendi _refresh'inde güncellenir.
		for _, card in ipairs(page._cards) do
			card._width = card._fullWidth and available or columnWidth
			card:_refresh(true)
		end

		local visibleCards = {}
		for _, card in ipairs(page._cards) do
			if card._frame and card._frame.Visible then
				visibleCards[#visibleCards + 1] = card
			end
		end

		local y = 0
		local rowCards = {}
		local rowHeight = 0

		local function placeRow()
			if #rowCards == 0 then return end
			rowHeight = 0
			for index, card in ipairs(rowCards) do
				local column = index - 1
				card._frame.Position = UDim2.fromOffset(column * (columnWidth + gap), y)
				card._frame.Size = UDim2.fromOffset(columnWidth, card._height)
				if card._height > rowHeight then
					rowHeight = card._height
				end
			end
			y = y + rowHeight + gap
			rowCards = {}
		end

		for _, card in ipairs(visibleCards) do
			if card._fullWidth then
				placeRow()
				card._frame.Position = UDim2.fromOffset(0, y)
				card._frame.Size = UDim2.fromOffset(available, card._height)
				y = y + card._height + gap
			else
				rowCards[#rowCards + 1] = card
				if #rowCards >= columns then
					placeRow()
				end
			end
		end
		placeRow()

		local totalHeight = math.max(0, y - gap) + 14
		page._holder.Size = UDim2.new(1, 0, 0, totalHeight)
		page._frame.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
		if page._empty then
			page._empty.Visible = (#visibleCards == 0 and (self._currentQuery or "") ~= "")
		end
	end

	function windowObject:_relayoutAll()
		for _, tab in ipairs(self._tabs) do
			for _, page in ipairs(tab._pages) do
				self:_relayout(page)
			end
		end
	end

	function windowObject:_applyFilter(text)
		local query = string.lower(text or "")
		self._currentQuery = query
		local tab = self._activeTab
		if not tab then return end

		for _, element in ipairs(tab._elements) do
			local visible = true
			if query ~= "" then
				local haystack = element._search or ""
				visible = string.find(string.lower(haystack), query, 1, true) ~= nil
			end
			if element.Frame then
				element.Frame.Visible = visible
			end
		end

		for _, page in ipairs(tab._pages) do
			self:_relayout(page)
		end
	end

