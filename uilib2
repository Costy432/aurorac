local ServiceCache = {}
local function Service(name)
	local cached = ServiceCache[name]
	if cached then return cached end
	local ok, service = pcall(function() return game:GetService(name) end)
	if ok and service then
		ServiceCache[name] = service
		return service
	end
	return nil
end

