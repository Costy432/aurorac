function Library:CreateWindow(config)
	if type(config) == "string" then
		config = { Title = config }
	end
	config = config or {}

	if self._window then
		pcall(function() self._window:Destroy() end)
	end
	self._destroyed = false
	self._notifications = {}
	local connectionBucket = {}
	self._bucket = connectionBucket

	local theme = self.Theme
	local titleText = config.Title or "AuroraUI"
	local subtitleText = config.Subtitle or "v" .. self.Version .. "  •  premium arayüz"
	local windowSize = config.Size or self.Options.WindowSize

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "AuroraUI"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.DisplayOrder = 999

	-- GUI ebeveyni: gethui() -> CoreGui -> PlayerGui (executor uyumluluğu)
	local function PickParent()
		if type(gethui) == "function" then
			local ok, hidden = pcall(gethui)
			if ok and hidden then return hidden end
		end
		if CoreGui then
			local ok = pcall(function() return #CoreGui:GetChildren() end)
			if ok then return CoreGui end
		end
		local player = Players and Players.LocalPlayer
		if player then
			local ok, playerGui = pcall(function()
				return player:FindFirstChild("PlayerGui")
			end)
			if ok and playerGui then return playerGui end
		end
		return nil
	end

	local guiParent = PickParent()
	local attached = false
	if guiParent then
		attached = pcall(function() screenGui.Parent = guiParent end)
	end
	if not attached or not screenGui.Parent then
		local player = Players and Players.LocalPlayer
		local ok, playerGui = pcall(function()
			return player and player:WaitForChild("PlayerGui", 5)
		end)
		if ok and playerGui then
			pcall(function() screenGui.Parent = playerGui end)
		end
	end

	self._gui = screenGui

	local root = New("Frame", {
		Name = "Root",
