		resizeGrip = grip

		local resizing = false
		local resizeStart = nil
		local startSize = nil
		local minimum = self.Options.MinWindowSize

		Connect(grip.InputBegan, function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				resizing = true
				resizeStart = input.Position
				startSize = windowRoot.AbsoluteSize
				if startSize.X <= 0 then
					startSize = windowSize
				else
					startSize = Vector2.new(startSize.X / baseScale, startSize.Y / baseScale)
				end
				local endConnection
				endConnection = Connect(input.Changed, function()
					if input.UserInputState == Enum.UserInputState.End then
						resizing = false
						endConnection:Disconnect()
					end
				end)
			end
		end)

		Connect(UserInputService.InputChanged, function(input)
			if not resizing then return end
			if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end
			local dx = (input.Position.X - resizeStart.X) / baseScale
			local dy = (input.Position.Y - resizeStart.Y) / baseScale
			local newWidth = Clamp(startSize.X + dx, minimum.X, 1400)
			local newHeight = Clamp(startSize.Y + dy, minimum.Y, 900)
			windowRoot.Size = UDim2.fromOffset(math.floor(newWidth), math.floor(newHeight))
			if self._resizeScheduled ~= true then
				self._resizeScheduled = true
				task.delay(0.04, function()
					self._resizeScheduled = false
					local activeWindow = self._window
					if activeWindow and not activeWindow._destroyed then
						activeWindow:_relayoutAll()
					end
				end)
			end
		end)
	end

