-- Executor uyumlu HTTP isteği (header destekleyenleri önce dener)
local function RequestRaw(url, headers)
	if type(url) ~= "string" or url == "" then return nil end

	local candidates = {}
	if syn and type(syn.request) == "function" then
		table.insert(candidates, function(opts) return syn.request(opts) end)
	end
	if http and type(http.request) == "function" then
		table.insert(candidates, function(opts) return http.request(opts) end)
	end
	if type(http_request) == "function" then
		table.insert(candidates, function(opts) return http_request(opts) end)
	end
	if type(request) == "function" then
		table.insert(candidates, function(opts) return request(opts) end)
	end

	for _, fetch in ipairs(candidates) do
		local ok, response = pcall(fetch, {
			Url = url,
			Method = "GET",
			Headers = headers or {},
		})
		if ok and type(response) == "table" and type(response.Body) == "string" and #response.Body > 0 then
			return {
				Body = response.Body,
				Headers = response.Headers or response.headers or {},
				StatusCode = response.StatusCode or response.StatusCode,
			}
		end
	end

	-- Header gerekmeyen tek parça indirme (Range yoksa)
	if not headers or next(headers) == nil then
		local ok, body = pcall(function() return game:HttpGet(url, true) end)
		if ok and type(body) == "string" and #body > 0 then
			return { Body = body, Headers = {}, StatusCode = 200 }
		end
	end
	return nil
end

local function HeaderValue(headers, key)
	if type(headers) ~= "table" then return nil end
	local wanted = string.lower(key)
	for name, value in pairs(headers) do
		if string.lower(tostring(name)) == wanted then
			return tostring(value)
		end
	end
	return nil
end

-- Executor dosya API'leri: writefile/isfile/makefolder ... (Xeno, Synapse, Fluxus uyumu)
local function ExecutorFn(name)
	local direct = rawget(_G, name)
	if type(direct) == "function" then return direct end
	local holders = { "syn", "fluxus", "krnl", "wave", "http" }
	for index = 1, #holders do
		local holder = rawget(_G, holders[index])
		if type(holder) == "table" and type(holder[name]) == "function" then
			return holder[name]
		end
	end
	return nil
end

local function FolderExists(path)
	local isFolder = ExecutorFn("isfolder")
	if not isFolder then return false end
	local ok, exists = pcall(isFolder, path)
	return ok and exists == true
end

local function EnsureFolder(filePath)
	local makeFolder = ExecutorFn("makefolder")
	if not makeFolder then return end
	local folder = string.match(filePath, "^(.*)/[^/]+$")
	if not folder or folder == "" then return end
	if FolderExists(folder) then return end
	-- iç içe klasörleri sırayla oluştur
	local built = ""
	for part in string.gmatch(folder, "[^/]+") do
		built = (built == "") and part or (built .. "/" .. part)
		if not FolderExists(built) then
			pcall(makeFolder, built)
		end
	end
end

--- Videoyu executor'ın workspace'ine indirir.
-- @return ok:boolean, pathOrError:string, bytes:number
function Library:DownloadIntroVideo(progressCallback)
	local path = self.Options.IntroVideoFile or "AuroraUI/intro.mp4"
	local url = self.Options.IntroVideoUrl

	local isFile = ExecutorFn("isfile")
	local getFileSize = ExecutorFn("getfilesize")
	if isFile then
		local okFile, exists = pcall(isFile, path)
		if okFile and exists then
			local size = 0
			if getFileSize then
				local okSize, result = pcall(getFileSize, path)
				if okSize and type(result) == "number" then size = result end
			end
			if size >= MIN_VIDEO_BYTES or (size == 0 and not getFileSize) then
				if progressCallback then progressCallback(-1, -1, "cached") end
				return true, path, size
			end
		end
	end

	if type(url) ~= "string" or url == "" then
		return false, "IntroVideoUrl boş"
	end
	local writeFile = ExecutorFn("writefile")
	if not writeFile then
		return false, "Executor writefile desteklemiyor"
	end

	local chunkSize = tonumber(self.Options.IntroVideoChunkSize) or (512 * 1024)
	if chunkSize < 65536 then chunkSize = 65536 end

	local totalBytes = nil
	local chunks = {}
	local downloaded = 0
	local useRange = true

	-- 1) Parça parça indirme (gerçek ilerleme yüzdesi)
	while useRange do
		local from = downloaded
		local to = downloaded + chunkSize - 1
		local response = RequestRaw(url, { ["Range"] = string.format("bytes=%d-%d", from, to) })
		if not response then
			useRange = false
			break
		end

		local contentRange = HeaderValue(response.Headers, "content-range")
		if contentRange then
			local total = string.match(contentRange, "/(%d+)")
			if total then totalBytes = tonumber(total) end
		elseif downloaded == 0 then
			local contentLength = HeaderValue(response.Headers, "content-length")
			if contentLength then totalBytes = tonumber(contentLength) end
		end

		table.insert(chunks, response.Body)
		downloaded = downloaded + #response.Body

		if progressCallback then
			progressCallback(downloaded, totalBytes, "download")
		end

		if #response.Body < chunkSize then
			break
		end
		if totalBytes and downloaded >= totalBytes then
			break
		end
		if #chunks > 128 then
			break
		end
	end

	local body = (#chunks > 0) and table.concat(chunks) or nil

	-- 2) Tek parça indirme (Range desteklenmiyorsa)
	if not body or #body < MIN_VIDEO_BYTES then
		if progressCallback then progressCallback(0, nil, "download-start") end
		local response = RequestRaw(url)
		if response and #response.Body >= MIN_VIDEO_BYTES then
			body = response.Body
			if progressCallback then progressCallback(#body, #body, "download") end
		else
			return false, "Video indirilemedi (ağ / executor engeli)"
		end
	end

	EnsureFolder(path)

	if progressCallback then progressCallback(#body, #body, "write") end
	local written, writeErr = pcall(writeFile, path, body)
	if not written then
		-- üst klasör oluşturulamadıysa kök dizine yazmayı dene
		local okRetry, retryErr = pcall(writeFile, "intro.mp4", body)
		if okRetry then
			self._introVideoBytes = #body
			return true, "intro.mp4", #body
		end
		return false, "Dosya yazılamadı: " .. tostring(writeErr) .. " / " .. tostring(retryErr)
	end

	self._introVideoBytes = #body
	return true, path, #body
end

-- Base64 çözücü (gömülü kareler için)
local BASE64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local Base64Lookup = nil
local function Base64Decode(input)
	if not Base64Lookup then
		Base64Lookup = {}
		for i = 1, 64 do
			Base64Lookup[string.byte(BASE64_CHARS, i)] = i - 1
		end
	end
	local out = {}
	local buffer = table.create and table.create(8192) or {}
	local size = #input
	local index = 1
	while index <= size do
		local a = Base64Lookup[string.byte(input, index)]
		local b = Base64Lookup[string.byte(input, index + 1)]
		if not a or not b then break end
		local c = Base64Lookup[string.byte(input, index + 2)]
		local d = Base64Lookup[string.byte(input, index + 3)]
		buffer[#buffer + 1] = string.char(a * 4 + math.floor(b / 16))
		if c then
			buffer[#buffer + 1] = string.char((b % 16) * 16 + math.floor(c / 4))
			if d then
				buffer[#buffer + 1] = string.char((c % 4) * 64 + d)
			end
		end
		if #buffer >= 60000 then
			out[#out + 1] = table.concat(buffer)
			buffer = table.create and table.create(8192) or {}
		end
		index = index + 4
	end
	if #buffer > 0 then out[#out + 1] = table.concat(buffer) end
	return table.concat(out)
end

--- Gömülü kareleri workspace'e yazar ve getcustomasset ile asset'e çevirir.
--- Hiç ağ gerekmez: kareler AuroraUI.lua'nın içinde.
function Library:UnpackEmbeddedFrames(progressCallback)
	local embedded = Library._EmbeddedFrames
	if type(embedded) ~= "table" or type(embedded.data) ~= "table" then
		return nil, "gömülü kare verisi yok"
	end
	if self._embeddedFrames then return self._embeddedFrames end

	local writeFile = ExecutorFn("writefile")
	local getCustomAsset = ExecutorFn("getcustomasset")
	if not writeFile or not getCustomAsset then
		return nil, "writefile/getcustomasset yok"
	end

	local dir = self.Options.IntroFramesFolder or "AuroraUI/frames"
	EnsureFolder(dir .. "/x")
	local isFile = ExecutorFn("isfile")
	local getFileSize = ExecutorFn("getfilesize")

	local meta = {
		fps = embedded.fps, cols = embedded.cols, rows = embedded.rows,
		frameW = embedded.frameW, frameH = embedded.frameH,
		count = embedded.count, duration = embedded.duration,
		atlas = embedded.atlas, assets = {},
	}
	local totalBytes = 0

	for index = 1, embedded.atlas do
		local encoded = embedded.data[index]
		if encoded then
			local path = string.format("%s/atlas_%02d.jpg", dir, index)
			local exists = false
			if isFile and getFileSize then
				local okFile, present = pcall(isFile, path)
				if okFile and present then
					local okSize, size = pcall(getFileSize, path)
					-- gömülü atlas ~100 KB; diskteki dosya makul boyuttaysa tekrar yazma
					exists = okSize and type(size) == "number" and size > 4096
				end
			end
			if not exists then
				local bytes = Base64Decode(encoded)
				local okWrite, writeErr = pcall(writeFile, path, bytes)
				if not okWrite then
					return nil, string.format("atlas_%02d yazılamadı: %s", index, tostring(writeErr))
				end
				totalBytes = totalBytes + #bytes
			end
			local okAsset, asset = pcall(getCustomAsset, path)
			if not okAsset or type(asset) ~= "string" or asset == "" then
				return nil, string.format("atlas_%02d getcustomasset başarısız", index)
			end
			meta.assets[index] = asset
		end
		if progressCallback then
			progressCallback(index, embedded.atlas, "embedded")
		end
	end

	meta.bytes = totalBytes
	self._embeddedFrames = meta
	if not self._introFrames then self._introFrames = meta end
	return meta
end

--- frames.txt manifestini ayrıştırır (küçük key=value dosyası)
local function ParseFramesManifest(text)
	local meta = {
		fps = 8, cols = 4, rows = 4, frameW = 384, frameH = 216,
		count = 0, duration = 19.28, atlas = 0,
	}
	for line in string.gmatch(text, "[^\r\n]+") do
		local key, value = string.match(line, "^%s*([%w_]+)%s*=%s*([%d%.]+)")
		local number = value and tonumber(value)
		if key and number then
			local field = ({
				fps = "fps", cols = "cols", rows = "rows", frameW = "frameW",
				frameH = "frameH", count = "count", duration = "duration", atlas = "atlas",
			})[key]
			if field then meta[field] = number end
		end
	end
	if meta.atlas < 1 or meta.cols < 1 or meta.rows < 1 then return nil end
	return meta
end

--- Kare atlaslarını GitHub'dan indirir (VideoFrame'in yerel dosya kısıtı yok).
--- @return meta table|nil, error string|nil
function Library:DownloadIntroFrames(progressCallback)
	local base = self.Options.IntroFramesUrl
	if type(base) ~= "string" or base == "" then return nil, "IntroFramesUrl boş" end
	if string.sub(base, -1) ~= "/" then base = base .. "/" end

	local dir = self.Options.IntroFramesFolder or "AuroraUI/frames"
	local isFile = ExecutorFn("isfile")
