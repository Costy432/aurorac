--=============================================================================
-- KÜTÜPHANE YARDIMCILARI
--=============================================================================
function Library:_closePopups()
	local closeFunctions = {}
	for _, closeFunction in pairs(self._popups) do
		if type(closeFunction) == "function" then
			table.insert(closeFunctions, closeFunction)
		end
	end
	self._popups = {}
	for _, closeFunction in ipairs(closeFunctions) do
		pcall(closeFunction)
	end
end

function Library:SetToggleKey(key)
	self.Options.ToggleKey = key
	local hint = self._hintLabel
	if hint then
		hint.Text = (key and tostring(key.Name) or "Yok") .. ": Aç/Kapa"
	end
end

function Library:SetBlurEnabled(enabled)
	self.Options.Blur = enabled == true
	local window = self._window
	-- Panel gizliyken oyun ekranına blur uygulanmasın
	if window and window:IsMinimized() then return end
	SetBlur(self.Options.Blur)
end

function Library:GetElement(flag)
	return self._flags[flag]
end

function Library:SaveConfig(name)
	name = name or "default"
	if type(writefile) ~= "function" then
		return false, "Executor writefile desteklemiyor"
	end

	local data = {}
	for flag, element in pairs(self._flags) do
		local kind = element._kind
		local ok, value = pcall(function() return element:Get() end)
		if ok and value ~= nil then
			if kind == "keybind" then
				data[flag] = tostring(value.Name)
			elseif kind == "colorpicker" then
				data[flag] = { r = value.R, g = value.G, b = value.B }
			elseif kind == "slider" then
				data[flag] = tonumber(value)
			elseif kind == "input" then
				data[flag] = tostring(value)
			elseif kind == "dropdown" then
				data[flag] = value
			elseif kind == "toggle" then
				data[flag] = value == true
			end
		end
	end

	local folder = self.Options.ConfigFolder or "AuroraUI"
	if type(isfolder) == "function" then
		local folderOk, exists = pcall(isfolder, folder)
		if folderOk and not exists and type(makefolder) == "function" then
			pcall(makefolder, folder)
		end
	end

	local encodedOk, encoded = pcall(function()
		return HttpService:JSONEncode(data)
	end)
	if not encodedOk then
		return false, "JSON kodlanamadı"
	end

	local path = folder .. "/" .. tostring(name) .. ".json"
	local saved, errorMessage = pcall(writefile, path, encoded)
	if not saved then
		return false, tostring(errorMessage)
	end

	if self._root then
		self:Notify({ Title = "Kaydedildi", Content = path, Type = "success", Duration = 3 })
	end
	return true, path
end

function Library:LoadConfig(name)
	name = name or "default"
	if type(readfile) ~= "function" then
		return false, "Executor readfile desteklemiyor"
	end

	local folder = self.Options.ConfigFolder or "AuroraUI"
	local path = folder .. "/" .. tostring(name) .. ".json"
	local readOk, content = pcall(readfile, path)
	if not readOk or type(content) ~= "string" then
		return false, "Dosya okunamadı"
	end

	local decodeOk, data = pcall(function()
		return HttpService:JSONDecode(content)
	end)
	if not decodeOk or type(data) ~= "table" then
		return false, "Geçersiz JSON"
	end

	for flag, value in pairs(data) do
		local element = self._flags[flag]
		if element then
			local kind = element._kind
			if kind == "keybind" then
				local keyCode = nil
				local codeOk, result = pcall(function() return Enum.KeyCode[tostring(value)] end)
				if codeOk then keyCode = result end
				pcall(function() element:Set(keyCode) end)
			elseif kind == "colorpicker" and type(value) == "table" then
				local red, green, blue = value.r or value[1] or 0, value.g or value[2] or 0, value.b or value[3] or 0
				if red > 1 or green > 1 or blue > 1 then
					red, green, blue = red / 255, green / 255, blue / 255
				end
				pcall(function() element:Set(Color3.new(red, green, blue)) end)
			elseif kind == "slider" then
				pcall(function() element:Set(tonumber(value) or 0) end)
			elseif kind == "toggle" then
				pcall(function() element:Set(value == true) end)
			else
				pcall(function() element:Set(value) end)
			end
		end
	end

	if self._root then
		self:Notify({ Title = "Yüklendi", Content = path, Type = "success", Duration = 3 })
	end
	return true
end

function Library:GetTabs()
	local window = self._window
	if not window then return {} end
	return window._tabs
end

function Library:GetWindow()
	return self._window
end

function Library:Destroy()
	if self._window then
		self._window:Destroy()
	end
end

return Library
