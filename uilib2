			if self._activeTab ~= tab then
				Tween(button, { BackgroundTransparency = 0.82 }, 0.16)
				TintIcon(iconHolder, theme.Text)
			end
			tooltipToken = tooltipToken + 1
			local token = tooltipToken
			task.delay(0.35, function()
				if token == tooltipToken and button.Parent and self._activeTab ~= tab then
					ShowTooltip(button, tostring(name))
				end
			end)
		end)
		button.MouseLeave:Connect(function()
			tooltipToken = tooltipToken + 1
			HideTooltip()
			if self._activeTab ~= tab then
				Tween(button, { BackgroundTransparency = 1 }, 0.16)
				TintIcon(iconHolder, theme.Muted)
			end
		end)

		button.MouseButton1Click:Connect(function()
			self:_selectTab(tab)
		end)

