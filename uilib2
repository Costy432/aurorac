	})

	local bg = New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = self.Theme.Panel,
		BackgroundTransparency = 0.03,
		BorderSizePixel = 0,
		Parent = toast,
	})
	Corner(bg, 12)
	Stroke(bg, self.Theme.Separator, 0.45)
	New("UIGradient", {
		Color = ColorSequence.new(self.Theme.Panel, self.Theme.Background),
		Rotation = 90,
		Parent = bg,
	})

	local accentBar = New("Frame", {
		Position = UDim2.new(0, 11, 0, 13),
		Size = UDim2.new(0, 3, 1, -26),
