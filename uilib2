CardAddLabel = function(card, text, opts)
	opts = opts or {}
	local theme = Library.Theme
	local size = opts.Size or 12
	local element = ElementBase(card, text, math.max(16, size + 4))

	local label = New("TextLabel", {
		Size = UDim2.new(1, 0, 0, element._height),
		BackgroundTransparency = 1,
		Font = opts.Bold and Enum.Font.GothamBold or Enum.Font.Gotham,
		Text = tostring(text),
		TextColor3 = opts.Color or theme.SubText,
		TextSize = size,
		TextXAlignment = opts.Center and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		RichText = opts.RichText == true,
		Parent = element.Frame,
	})

	element._measure = function(width)
		local characters = math.max(1, math.floor(width / (size * 0.53)))
		local lines = math.max(1, math.ceil(#label.Text / characters))
		local labelHeight = math.max(16, lines * (size + 4))
		label.Size = UDim2.new(1, 0, 0, labelHeight)
		return labelHeight
	end

	element._kind = "label"
	card:_refresh()
	return element
end

CardAddParagraph = function(card, title, body, opts)
	opts = opts or {}
	local theme = Library.Theme
	local element = ElementBase(card, tostring(title) .. " " .. tostring(body), 40)

	local titleLabel = New("TextLabel", {
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = tostring(title or ""),
		TextColor3 = opts.Color or theme.Text,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = element.Frame,
	})

	local bodyLabel = New("TextLabel", {
		Position = UDim2.new(0, 0, 0, 18),
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		Font = Enum.Font.Gotham,
		Text = tostring(body or ""),
		TextColor3 = opts.BodyColor or theme.SubText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		Parent = element.Frame,
	})

	element._measure = function(width)
		local characters = math.max(1, math.floor(width / (11 * 0.53)))
		local lines = math.max(1, math.ceil(#bodyLabel.Text / characters))
		local bodyHeight = math.max(15, lines * 15)
		bodyLabel.Size = UDim2.new(1, 0, 0, bodyHeight)
		return 18 + bodyHeight + 6
	end

	element._kind = "paragraph"
	card:_refresh()
	return element
end

