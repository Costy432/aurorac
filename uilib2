		BorderSizePixel = 0,
		Parent = bg,
	})
	PillCorner(accentBar)
	New("UIGradient", {
		Color = ColorSequence.new(accent, self.Theme.Accent2),
		Rotation = 90,
		Parent = accentBar,
	})

	New("TextLabel", {
		Position = UDim2.new(0, 23, 0, 12),
		Size = UDim2.new(1, -66, 0, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = title,
		TextColor3 = self.Theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = bg,
	})

	if hasContent then
		New("TextLabel", {
			Position = UDim2.new(0, 23, 0, 30),
			Size = UDim2.new(1, -46, 0, 28),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = content,
			TextColor3 = self.Theme.SubText,
			TextSize = 11,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Top,
			Parent = bg,
		})
	end

	local close = New("TextButton", {
		Position = UDim2.new(1, -30, 0, 10),
		Size = UDim2.fromOffset(20, 20),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = bg,
	})
	local closeIcon = MakeX(close, 8, self.Theme.Muted, 1.4)
	closeIcon.Position = UDim2.fromScale(0.5, 0.5)
	closeIcon.AnchorPoint = Vector2.new(0.5, 0.5)

	local progressTrack = New("Frame", {
		Position = UDim2.new(0, 11, 1, -6),
		Size = UDim2.new(1, -22, 0, 2),
		BackgroundColor3 = accent,
		BackgroundTransparency = 0.8,
		BorderSizePixel = 0,
		Parent = bg,
	})
	PillCorner(progressTrack)

	local progress = New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Parent = progressTrack,
	})
	PillCorner(progress)

	local item = {
		toast = toast,
		height = height,
	}

	-- Kapasite aşımı: en eskiyi kapat
	while #self._notifications >= (self.Options.MaxNotifications or 4) do
		local oldest = self._notifications[1]
		RemoveNotification(oldest, true)
		if #self._notifications == 0 then break end
	end

	table.insert(self._notifications, item)
	RecalcNotifications()

	if item._targetY then
		toast.Position = UDim2.fromOffset(42, item._targetY)
		Tween(toast, { Position = UDim2.fromOffset(0, item._targetY) }, 0.32, EASE.Quint)
	end

	Tween(toast, { GroupTransparency = 0 }, 0.25, EASE.Quad)

	local progressTween = Tween(progress, { Size = UDim2.fromScale(0, 1) }, math.max(duration, 0.8), EASE.Linear)
	if progressTween then
		progressTween.Completed:Connect(function()
			RemoveNotification(item, false)
		end)
		item.progressTween = progressTween
	end

	bg.MouseEnter:Connect(function()
		if item.progressTween then
			pcall(function() item.progressTween:Pause() end)
		end
	end)
	bg.MouseLeave:Connect(function()
		if item.progressTween then
			pcall(function() item.progressTween:Play() end)
		end
	end)
	close.MouseButton1Click:Connect(function()
		RemoveNotification(item, false)
	end)

	return item
end

local function TintIcon(holder, color)
	if not holder then return end
	local ok, descendants = pcall(function() return holder:GetDescendants() end)
	if not ok or not descendants then return end
	for _, inst in ipairs(descendants) do
		if inst:IsA("Frame") then
			inst.BackgroundColor3 = color
		elseif inst:IsA("ImageLabel") then
			inst.ImageColor3 = color
		elseif inst:IsA("UIStroke") then
			inst.Color = color
		end
	end
end

