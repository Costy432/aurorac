		return Library._notifyHolder
	end
	if not Library._root then return nil end
	local holder = New("Frame", {
		Name = "AuroraNotifications",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -18, 0, 18),
		Size = UDim2.new(0, 292, 0, 0),
		BackgroundTransparency = 1,
		ZIndex = 700,
		Parent = Library._root,
	})
	Library._notifyHolder = holder
	return holder
end

local function RecalcNotifications()
	local y = 0
	for _, item in ipairs(Library._notifications) do
		if item.toast and item.toast.Parent then
			item._targetY = y
			Tween(item.toast, { Position = UDim2.fromOffset(0, y) }, 0.28, EASE.Quint)
			y = y + item.height + 8
		end
	end
end

local function RemoveNotification(item, instant)
	if item.closing then return end
	item.closing = true
	for index, entry in ipairs(Library._notifications) do
		if entry == item then
			table.remove(Library._notifications, index)
			break
		end
	end
	if item.toast then
		local targetY = item.toast.Position.Y.Offset
		Tween(item.toast, { GroupTransparency = 1 }, instant and 0.01 or 0.22, EASE.Quad)
		Tween(item.toast, { Position = UDim2.fromOffset(48, targetY) }, instant and 0.01 or 0.22, EASE.Quad)
		local toast = item.toast
		task.delay(instant and 0.02 or 0.26, function()
			if toast then toast:Destroy() end
		end)
	end
	RecalcNotifications()
end

function Library:Notify(options)
	if type(options) == "string" then
		options = { Title = options }
	end
	options = options or {}

	local title = options.Title or options.title or "Bildirim"
	local content = options.Content or options.Text or options.Description or ""
	local kind = options.Type or options.kind or "info"
	local duration = options.Duration or 4

	local palette = {
		info = self.Theme.Accent,
		default = self.Theme.Accent,
		success = self.Theme.Success,
		warning = self.Theme.Warning,
		warn = self.Theme.Warning,
