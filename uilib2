		end

		function tab:_currentPage()
			if self._activeSub then
				return self._activeSub._page
			end
			return self._basePage
		end

		function tab:AddCard(cardTitle, options)
			return Library:_createCard(self, self:_currentPage(), cardTitle, options)
		end

		function tab:AddSubTab(subName)
			local sub = {
				Name = subName,
				_tab = tab,
			}

			local chip = New("TextButton", {
				LayoutOrder = #tab._subTabs + 1,
				Size = UDim2.fromOffset(10, 26),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = theme.Element,
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamMedium,
				Text = tostring(subName),
				TextColor3 = theme.SubText,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Center,
				AutoButtonColor = false,
				ZIndex = 5,
				Parent = chips,
			})
			Corner(chip, 8)
			Padding(chip, 0, 0, 0, 12, 12)
			local chipGradient = AccentGradient(chip, 45)
			chipGradient.Enabled = false

			local page = createPage()
			sub._page = page
			sub._chip = chip
			sub._chipGradient = chipGradient
			table.insert(tab._pages, page)
			table.insert(tab._subTabs, sub)

			chip.MouseEnter:Connect(function()
				if tab._activeSub ~= sub then
					Tween(chip, { BackgroundTransparency = 0.82, TextColor3 = theme.Text }, 0.15)
				end
			end)
			chip.MouseLeave:Connect(function()
				if tab._activeSub ~= sub then
					Tween(chip, { BackgroundTransparency = 1, TextColor3 = theme.SubText }, 0.15)
				end
			end)
			chip.MouseButton1Click:Connect(function()
				tab:_selectSub(sub)
			end)

			function sub:AddCard(cardTitle, options)
				return Library:_createCard(self._tab, self._page, cardTitle, options)
			end

			function sub:Select()
				self._tab:_selectSub(self)
			end

			tab:_selectSub(sub)

			return sub
		end

		function tab:_selectSub(sub)
			self._activeSub = sub
			for _, other in ipairs(self._subTabs) do
				local active = (other == sub)
				other._chipGradient.Enabled = active
				Tween(other._chip, {
					BackgroundTransparency = active and 0.82 or 1,
					TextColor3 = active and theme.Text or theme.SubText,
				}, 0.18)
			end
			-- Sekme aktif değilken sayfa görünürlüğüne dokunma; aksi halde
			-- aktif sekmenin içeriğiyle üst üste biner.
			if self._window._activeTab == self then
				for _, page in ipairs(self._pages) do
					page._frame.Visible = (page == sub._page)
				end
				self._window:_relayout(sub._page)
			end
		end

		function tab:_activate()
			self._chips.Visible = true
			local page = self:_currentPage()
			for _, candidate in ipairs(self._pages) do
				candidate._frame.Visible = (candidate == page)
			end
			self._buttonGradient.Enabled = true
			Tween(self._button, { BackgroundTransparency = 0.82 }, 0.2)
			Tween(self._marker, { Size = UDim2.new(0, 3, 0, 16), BackgroundTransparency = 0 }, 0.22)
			TintIcon(self._icon, theme.Text)
			page._frame.Position = UDim2.new(0, 0, 0, 8)
			Tween(page._frame, { Position = UDim2.new(0, 0, 0, 0) }, 0.26, EASE.Quint)
			self._window:_relayout(page)
		end

		function tab:_deactivate()
			self._chips.Visible = false
			for _, candidate in ipairs(self._pages) do
				candidate._frame.Visible = false
			end
			self._buttonGradient.Enabled = false
			Tween(self._button, { BackgroundTransparency = 1 }, 0.18)
			Tween(self._marker, { Size = UDim2.new(0, 3, 0, 0), BackgroundTransparency = 1 }, 0.18)
			TintIcon(self._icon, theme.Muted)
		end

		table.insert(self._tabs, tab)
		if #self._tabs == 1 then
			self:_selectTab(tab, true)
		end
		return tab
	end

	function windowObject:_selectTab(tab, instant)
		if not tab then return end
		if self._activeTab == tab and not instant then return end
		if self._activeTab and self._activeTab ~= tab then
			for _, element in ipairs(self._activeTab._elements) do
				if element.Frame then
					element.Frame.Visible = true
				end
			end
		end
		self._activeTab = tab
		for _, other in ipairs(self._tabs) do
			if other ~= tab then
				other:_deactivate()
			end
		end
		Library:_closePopups()
		HideTooltip()
		tab:_activate()
		if self._searchBox and self._searchBox.Text ~= "" then
			self._searchBox.Text = ""
		end
		self:_applyFilter("")
	end

	function windowObject:SelectTab(target)
		for index, tab in ipairs(self._tabs) do
			if tab == target or tab.Name == target or index == target then
				self:_selectTab(tab)
				return tab
			end
		end
		return nil
	end

	function windowObject:SetScale(percent)
		local value = (tonumber(percent) or 100) / 100
		baseScale = Clamp(value, 0.5, 2)
		Tween(uiScale, { Scale = baseScale }, 0.22, EASE.Quad)
		self:_relayoutAll()
	end

	function windowObject:GetScale()
		return math.floor(baseScale * 100 + 0.5)
	end

	function windowObject:SetTitle(newTitle)
		self.Title = newTitle
		titleLabel.Text = tostring(newTitle)
	end

	function windowObject:SetStatus(text)
		subtitleLabel.Text = tostring(text)
	end

	--==========================================================================
	-- KÜÇÜLTME / GERİ YÜKLEME
	--==========================================================================
	local minimized = false

	-- Hiçbir kalıntı piksel kalmaması için panel tamamen gizlenir:
	--   • uiGroup.Visible = false
	--   • orb kapalıysa ScreenGui.Enabled = false  -> ekranda 0 piksel
	-- (GroupTransparency tek başına UIStroke/gradient kenarlıklarda iz bırakabiliyor)
	local function applyHidden(hidden)
		if hidden then
			uiGroup.Visible = false
			if Library.Options.MinimizeToOrb == true then
				screenGui.Enabled = true
				orb.Visible = true
				Tween(orb, { GroupTransparency = 0 }, 0.22)
			else
				orb.Visible = false
				orb.GroupTransparency = 1
				screenGui.Enabled = false
			end
		else
			screenGui.Enabled = true
			uiGroup.Visible = true
			orb.Visible = false
			orb.GroupTransparency = 1
		end
	end

	function windowObject:Minimize()
		if minimized or self._destroyed then return end
		minimized = true
		HideTooltip()
		Library:_closePopups()

		Tween(uiScale, { Scale = baseScale * 0.96 }, 0.14, EASE.Quad)
		Tween(uiGroup, { GroupTransparency = 1 }, 0.14, EASE.Quad)

		task.delay(0.15, function()
			if minimized and not self._destroyed then
				applyHidden(true)
			end
		end)

		SetBlur(false)
	end

	function windowObject:Restore()
		if not minimized then return end
		minimized = false

		applyHidden(false)
		uiScale.Scale = baseScale
		Tween(uiGroup, { GroupTransparency = 0 }, 0.16, EASE.Quad)
		Tween(uiScale, { Scale = baseScale }, 0.2, EASE.Quint)
		if Library.Options.Blur then
			SetBlur(true)
		end
		self:_relayoutAll()
	end

	function windowObject:Toggle()
		if minimized then
			self:Restore()
		else
			self:Minimize()
		end
	end

	function windowObject:SetVisible(visible)
		if visible then
			self:Restore()
		else
			self:Minimize()
		end
	end

	function windowObject:IsVisible()
		return not minimized
	end

	function windowObject:IsMinimized()
		return minimized
	end

	--==========================================================================
	-- KAPATMA
	--==========================================================================
	function windowObject:Destroy()
		if self._destroyed then return end
		self._destroyed = true
		if Library._window == self then
			Library._window = nil
		end
		HideTooltip()
		Library._sliderActive = nil
		Library._keybindTarget = nil
		Library._colorDrag = nil
		local ownedLoading = self._loading
		if ownedLoading and Library._loading == ownedLoading and ownedLoading.Destroy then
			pcall(function() ownedLoading.Destroy() end)
		end
		Tween(uiGroup, { GroupTransparency = 1 }, 0.2)
		Tween(orb, { GroupTransparency = 1 }, 0.2)
		SetBlur(false)

		for _, connection in ipairs(self._connections) do
			pcall(function() connection:Disconnect() end)
		end
		self._connections = {}

		local guiReference = screenGui
		local rootReference = root
		Library._popups = {}
		Library._colorDrag = nil

		task.delay(0.24, function()
			pcall(function() guiReference:Destroy() end)
			if Library._gui == guiReference then
				Library._gui = nil
				Library._root = nil
				Library._tooltip = nil
				Library._notifyHolder = nil
				Library._notifications = {}
				Library._flags = {}
				Library._sliderActive = nil
				Library._keybindTarget = nil
			end
		end)
	end

	--==========================================================================
	-- ETKİLEŞİMLER
	--==========================================================================
	minimizeButton.MouseButton1Click:Connect(function()
		windowObject:Minimize()
	end)
	closeButton.MouseButton1Click:Connect(function()
		windowObject:Destroy()
	end)
	hideButton.MouseButton1Click:Connect(function()
		windowObject:Minimize()
	end)
	orbButton.MouseButton1Click:Connect(function()
		if not orbDragState.moved then
			windowObject:Restore()
		end
	end)

	Connect(dragArea.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Library:_closePopups()
			HideTooltip()
		end
	end)

	MakeDraggable(dragArea, windowRoot, function(x, y)
		local viewportNow = Viewport()
		local currentSize = windowRoot.AbsoluteSize
		local width = currentSize.X > 0 and currentSize.X or windowSize.X
		local height = currentSize.Y > 0 and currentSize.Y or windowSize.Y
		return Clamp(x, -width + 150, viewportNow.X - 150), Clamp(y, 0, viewportNow.Y - 70)
	end)

	Connect(searchBox:GetPropertyChangedSignal("Text"), function()
		windowObject:_applyFilter(searchBox.Text)
	end)
	Connect(searchBox.Focused, function()
		Tween(searchStroke, { Transparency = 0.35, Color = theme.Accent }, 0.16)
	end)
	Connect(searchBox.FocusLost, function()
		Tween(searchStroke, { Transparency = 0.9, Color = theme.Stroke }, 0.16)
	end)

	Connect(UserInputService.InputBegan, function(input, gameProcessed)
		if Library._keybindTarget or Library._sliderActive then return end
		if gameProcessed then return end
		if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
		local toggleKey = Library.Options.ToggleKey
		if toggleKey and input.KeyCode == toggleKey then
			if Library._window == windowObject and not windowObject._destroyed then
				windowObject:Toggle()
			end
		elseif input.KeyCode == Enum.KeyCode.Escape then
			Library:_closePopups()
		end
	end)

	--==========================================================================
	-- AÇILIŞ: SİNEMATİK YÜKLEME EKRANI + PANEL ANİMASYONU
	--==========================================================================
	local function runWindowIntro()
		if Library.Options.Blur then
			SetBlur(true)
		end

		if not Library.Options.Intro then
			uiGroup.GroupTransparency = 0
			uiScale.Scale = baseScale
			return
		end

		uiGroup.GroupTransparency = 1
		uiScale.Scale = baseScale * 0.93
		task.delay(0.06, function()
			Tween(uiGroup, { GroupTransparency = 0 }, 0.45, EASE.Quad)
			Tween(uiScale, { Scale = baseScale }, 0.6, EASE.Back, DIR.Out)
		end)

		local sweep = New("Frame", {
			Size = UDim2.new(0, 180, 2, 0),
			Position = UDim2.new(0, -320, 0, -120),
			Rotation = 16,
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 0.93,
			BorderSizePixel = 0,
			ZIndex = 30,
			Parent = main,
		})
		New("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.88),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = sweep,
		})
		task.delay(0.18, function()
			Tween(sweep, { Position = UDim2.new(1, 320, 0, -120) }, 0.95, EASE.Quad, DIR.Out)
			task.delay(1.05, function()
				if sweep then sweep:Destroy() end
			end)
		end)
	end

	local wantsLoading = Library.Options.LoadingScreen ~= false
	if wantsLoading then
		-- Panel, intro bitene kadar tamamen kapalı
		screenGui.Enabled = false
		uiGroup.GroupTransparency = 1
		uiScale.Scale = baseScale
		windowObject._loading = Library:PlayLoadingScreen(function()
			if windowObject._destroyed then return end
			screenGui.Enabled = true
			Library:_relayoutAll()
			runWindowIntro()
		end)
	else
		screenGui.Enabled = true
		runWindowIntro()
	end

	return windowObject
end

--=============================================================================
-- KART OLUŞTURMA
--=============================================================================
local function NormalizeOpts(opts, callback)
	if type(opts) == "function" and callback == nil then
		return {}, opts
	end
	if type(opts) ~= "table" then
		opts = {}
	end
	return opts, callback or opts.Callback
end

local function ElementBase(card, text, height)
	local theme = Library.Theme
	local frame = New("Frame", {
		Size = UDim2.new(1, -20, 0, height),
		Position = UDim2.fromOffset(10, 0),
		BackgroundTransparency = 1,
		Parent = card._content,
	})

	local element = {
		Frame = frame,
		_height = height,
		_search = tostring(text or "") .. " " .. tostring(card.Title or ""),
		_card = card,
		_tab = card._tab,
	}

	table.insert(card._elements, element)
	table.insert(card._tab._elements, element)

	return element
end

function Library:_createCard(tab, page, cardTitle, options)
	options = options or {}
	local theme = self.Theme

	local card = {
		Title = cardTitle,
		_tab = tab,
		_page = page,
		_width = 320,
		_height = 90,
		_elements = {},
		_fullWidth = (options.FullWidth == true or options.Full == true),
	}

	local frame = New("Frame", {
		Name = tostring(cardTitle),
		BackgroundColor3 = theme.Card,
		BackgroundTransparency = theme.CardTransparency,
		BorderSizePixel = 0,
		ClipsDescendants = false,
		Parent = page._holder,
	})
	Corner(frame, 12)

	local cardStroke = Stroke(frame, theme.Stroke, 0.94)

	New("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(24, 28, 40), Color3.fromRGB(16, 19, 27)),
		Rotation = 90,
		Parent = frame,
	})

	local accentBar = New("Frame", {
		Position = UDim2.new(0, 12, 0, 15),
		Size = UDim2.fromOffset(3, 12),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Parent = frame,
	})
	PillCorner(accentBar)
	AccentGradient(accentBar, 90)

	local titleLabel = New("TextLabel", {
		Position = UDim2.new(0, 21, 0, 12),
		Size = UDim2.new(1, -33, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		Text = tostring(cardTitle),
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})

	local headerLine = New("Frame", {
		Position = UDim2.new(0, 12, 0, 36),
		Size = UDim2.new(1, -24, 0, 1),
		BackgroundColor3 = theme.Separator,
		BackgroundTransparency = 0.55,
		BorderSizePixel = 0,
		Parent = frame,
	})
	New("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.25),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = headerLine,
	})

	local content = New("Frame", {
		Name = "Content",
		Position = UDim2.new(0, 0, 0, 42),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundTransparency = 1,
		Parent = frame,
	})

	card._frame = frame
	card._content = content
	card._stroke = cardStroke
	card._titleLabel = titleLabel
	card._accentBar = accentBar

	function card:_refresh(skipLayout)
		local width = self._width or 320
		local contentWidth = width - 20
		local y = 0
		local anyVisible = false

		for _, element in ipairs(self._elements) do
			local elementHeight = element._height or 34
			if element._measure then
				local ok, measured = pcall(element._measure, contentWidth)
				if ok and type(measured) == "number" and measured > 0 then
					elementHeight = measured
				end
			end

			if element.Frame and element.Frame.Visible then
				element.Frame.Size = UDim2.new(1, -20, 0, elementHeight)
				element.Frame.Position = UDim2.fromOffset(10, y)
				element._currentHeight = elementHeight
				y = y + elementHeight + 4
				anyVisible = true
			end
		end

		local query = ""
		if self._tab and self._tab._window then
			query = self._tab._window._currentQuery or ""
		end
		self._frame.Visible = (query == "" or anyVisible) and #self._elements > 0

		if y > 0 then
			y = y - 4
		end

		local height = math.max(58, 42 + y + 10)
		self._height = height
		self._frame.Size = UDim2.fromOffset(width, height)
		self._content.Size = UDim2.new(1, 0, 0, math.max(0, y))

		if not skipLayout then
			self._tab._window:_relayout(self._page)
		end
	end

	-- Hover: çerçeve hafif parlar
	frame.MouseEnter:Connect(function()
		Tween(cardStroke, { Transparency = 0.82 }, 0.18)
	end)
	frame.MouseLeave:Connect(function()
		Tween(cardStroke, { Transparency = 0.94 }, 0.18)
	end)

	-- Kart metotları
	function card:AddToggle(text, opts, callback)
		local normalized, cb = NormalizeOpts(opts, callback)
		return CardAddToggle(self, text, normalized, cb)
	end

	function card:AddButton(text, callback, opts)
		if type(callback) == "table" and opts == nil then
			opts = callback
			callback = opts.Callback
		end
		return CardAddButton(self, text, callback, opts or {})
	end

	function card:AddSlider(text, opts, callback)
		local normalized, cb = NormalizeOpts(opts, callback)
		return CardAddSlider(self, text, normalized, cb)
	end

	function card:AddDropdown(text, opts, callback)
		local normalized, cb = NormalizeOpts(opts, callback)
		return CardAddDropdown(self, text, normalized, cb)
	end

	function card:AddInput(text, opts, callback)
		local normalized, cb = NormalizeOpts(opts, callback)
		return CardAddInput(self, text, normalized, cb)
	end

	function card:AddKeybind(text, opts, callback)
		local normalized, cb = NormalizeOpts(opts, callback)
		return CardAddKeybind(self, text, normalized, cb)
	end

	function card:AddColorPicker(text, opts, callback)
		local normalized, cb = NormalizeOpts(opts, callback)
		return CardAddColorPicker(self, text, normalized, cb)
	end

	function card:AddLabel(text, opts)
		return CardAddLabel(self, text, opts)
	end

	function card:AddParagraph(title, body, opts)
		return CardAddParagraph(self, title, body, opts)
	end

	function card:AddDivider()
		return CardAddDivider(self)
	end

	function card:AddSpace(height)
		return CardAddSpace(self, height)
	end

	function card:AddSection(text)
		return CardAddSection(self, text)
	end

	function card:SetTitle(text)
		self.Title = text
		titleLabel.Text = tostring(text)
	end

	table.insert(page._cards, card)
	table.insert(tab._cards, card)
	card:_refresh()

	return card
end

--=============================================================================
-- ELEMAN: TOGGLE
--=============================================================================
CardAddToggle = function(card, text, opts, callback)
	opts = opts or {}
	local theme = Library.Theme
	local hasDesc = opts.Description ~= nil
	local height = hasDesc and 46 or 34
	local element = ElementBase(card, text, height)
	local frame = element.Frame

	New("TextLabel", {
		Position = UDim2.new(0, 0, 0, hasDesc and 4 or 0),
		Size = UDim2.new(1, -56, 0, hasDesc and 16 or height),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = tostring(text),
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})

	if hasDesc then
		New("TextLabel", {
			Position = UDim2.new(0, 0, 0, 22),
			Size = UDim2.new(1, -56, 0, 16),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = tostring(opts.Description),
			TextColor3 = theme.SubText,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = frame,
		})
	end

	local switch = New("TextButton", {
		Position = UDim2.new(1, -38, 0, hasDesc and 0 or (height - 20) / 2),
		Size = UDim2.fromOffset(38, 20),
		BackgroundColor3 = theme.Element,
		BackgroundTransparency = 0,
		Text = "",
		AutoButtonColor = false,
		Parent = frame,
	})
	PillCorner(switch)
	local switchStroke = Stroke(switch, theme.Stroke, 0.88, 1)
	local switchGradient = AccentGradient(switch, 45)
	switchGradient.Enabled = false

	local knob = New("Frame", {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 3, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = switch,
	})
	PillCorner(knob)
	New("UIStroke", {
		Color = Color3.fromRGB(0, 0, 0),
		Transparency = 0.75,
		Parent = knob,
	})

	local state = opts.Default == true
	local flag = opts.Flag or tostring(text)
	element._kind = "toggle"

	local function apply(value, silent)
		state = value and true or false
		switchGradient.Enabled = state
		Tween(switch, {
			BackgroundColor3 = state and theme.Accent or theme.Element,
		}, 0.18)
		Tween(knob, {
			Position = state and UDim2.new(0, 21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
		}, 0.22, EASE.Back, DIR.Out)
		if not silent then
			SafeCallback(callback, state)
		end
	end

	switch.MouseEnter:Connect(function()
		Tween(switchStroke, { Transparency = 0.7 }, 0.15)
	end)
	switch.MouseLeave:Connect(function()
		Tween(switchStroke, { Transparency = 0.88 }, 0.15)
	end)

	switch.MouseButton1Click:Connect(function()
		apply(not state, false)
	end)

	function element:Set(value, silent)
		apply(value, silent == true)
	end

	function element:Get()
		return state
	end

	element.Toggle = function()
		apply(not state, false)
	end

	apply(state, true)
	if flag then
		Library._flags[flag] = element
	end

	card:_refresh()
	return element
end

