-- ANA FONKSİYON
--=============================================================================
function Library:PlayLoadingScreen(onFinish)
	if self._loading then
		return self._loading
	end

	local theme = self.Theme
	local speed = tonumber(self.Options.LoadingSpeed) or 1
	if speed <= 0 then speed = 1 end
	local function at(seconds)
		return seconds / speed
	end

	local loading = {
		cancelled = false,
		finished = false,
		boomed = false,
		phase = "download",
	}
	self._loading = loading

	local gui = Instance.new("ScreenGui")
	gui.Name = "AuroraLoading"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 20000
	local parentGui = PickGuiParent()
	if parentGui then
		pcall(function() gui.Parent = parentGui end)
	end
	if not gui.Parent then
		local players = Service("Players")
		local player = players and players.LocalPlayer
		local ok, playerGui = pcall(function() return player and player:FindFirstChild("PlayerGui") end)
		if ok and playerGui then
			pcall(function() gui.Parent = playerGui end)
		end
	end

	local viewport = Viewport()
	local unit = viewport.Y / 720

	-- Kök
	local root = New("CanvasGroup", {
		Name = "LoadingRoot",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(0, 0, 0),
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		GroupTransparency = 0,
		Parent = gui,
	})

	-- FAZ 1: indirme ekranı
	local downloadScreen = BuildDownloadScreen(root, unit)

	-- FAZ 2 konteyneri (video + yazılar + patlama) — indirme bitince doldurulur
	local showContainer = New("CanvasGroup", {
		Name = "Show",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Parent = root,
	})

	local phaseObject = nil

	-- Zamanlayıcı yardımcıları
	local function step(seconds, fn)
		task.delay(at(seconds), function()
			if loading.cancelled or loading.finished then return end
			fn()
		end)
	end

	--==========================================================================
	-- FAZ 2: VİDEO + YAZILAR + PATLAMA
	--==========================================================================
	local function buildShowPhase(asset)
		local videoHolder = New("Frame", {
			Name = "VideoHolder",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			Parent = showContainer,
		})
		local function applyCover()
			local vp = Viewport()
			local cover = math.max(vp.X / 16, vp.Y / 9)
			videoHolder.Size = UDim2.fromOffset(16 * cover, 9 * cover)
			videoHolder.Position = UDim2.fromOffset(
				math.floor((vp.X - 16 * cover) / 2),
				math.floor((vp.Y - 9 * cover) / 2)
			)
		end
		applyCover()

		local fallback = BuildAuroraBackdrop(showContainer)

		-- vinyet
		local vignetteTop = New("Frame", {
			Size = UDim2.new(1, 0, 0.32, 0),
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BackgroundTransparency = 0.25,
			BorderSizePixel = 0,
			Parent = showContainer,
		})
		New("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.15),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = vignetteTop,
		})
		local vignetteBottom = vignetteTop:Clone()
		vignetteBottom.Position = UDim2.new(0, 0, 0.68, 0)
		vignetteBottom.Rotation = 180
		vignetteBottom.Parent = showContainer

		-- sinema bantları
		-- NOT: bantlar 0 yükseklikte başlar; video tam ekran görünür.
		-- Sekans başlarken 8.5%, ekran bölünürken 19% yüksekliğe açılır.
		local letterTop = New("Frame", {
			Name = "LetterTop",
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BorderSizePixel = 0,
			ZIndex = 40,
			Parent = showContainer,
		})
		local letterBottom = New("Frame", {
			Name = "LetterBottom",
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundColor3 = Color3.fromRGB(0, 0, 0),
			BorderSizePixel = 0,
			ZIndex = 40,
			Parent = showContainer,
		})

		-- enerji çizgisi
		local seam = New("Frame", {
			Name = "Seam",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 0, 0, 2),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 45,
			Parent = showContainer,
		})
		AccentGradient(seam, 0)
		local seamGlow = New("Frame", {
			Name = "SeamGlow",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 0, 0, 46 * unit),
			BackgroundColor3 = theme.Accent,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 44,
			Parent = showContainer,
		})
		New("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.55),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = seamGlow,
		})

		-- yazılar
		local introTexts = self.Options.LoadingTexts or {}
		local fontSize = math.floor(78 * unit)
		local bestGroup = BuildCinematicText(showContainer, introTexts.Best or "BEST", fontSize, 22)
		local universalGroup = BuildCinematicText(showContainer, introTexts.Universal or "UNIVERSAL",
			math.floor(fontSize * 0.86), 24)
		local scriptGroup = BuildCinematicText(showContainer, introTexts.Script or "SCRIPT",
			math.floor(fontSize * 1.06), 24)

		bestGroup.group.AnchorPoint = Vector2.new(0.5, 0.5)
		bestGroup.group.Position = UDim2.fromScale(0.5, 0.62)
		bestGroup.group.Size = UDim2.new(1, 0, 0, fontSize * 1.6)

		universalGroup.group.AnchorPoint = Vector2.new(0.5, 0.5)
		universalGroup.group.Position = UDim2.fromScale(0.5, 0.5)
		universalGroup.group.Size = UDim2.new(1, 0, 0, fontSize * 1.6)

		scriptGroup.group.AnchorPoint = Vector2.new(0.5, 0.5)
		scriptGroup.group.Position = UDim2.fromScale(0.5, 0.5)
		scriptGroup.group.Size = UDim2.new(1, 0, 0, fontSize * 1.6)

		local textGroups = { bestGroup, universalGroup, scriptGroup }
		for _, textGroup in ipairs(textGroups) do
			HideTextGroup(textGroup)
		end

		-- patlama katmanları
		local flash = New("Frame", {
			Name = "Flash",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ZIndex = 60,
			Parent = showContainer,
		})

		local ring = New("Frame", {
			Name = "Ring",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(30, 30),
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 58,
			Parent = showContainer,
		})
		PillCorner(ring)
		local ringStroke = New("UIStroke", {
			Color = theme.Accent2,
			Thickness = 6,
			Transparency = 0.1,
			Parent = ring,
		})
		AccentGradient(ringStroke, 90)

		local shardLayer = New("Frame", {
			Name = "Shards",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 57,
			Parent = showContainer,
		})

		-- alt bilgi
		local progressTrack = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -26 * unit),
			Size = UDim2.new(0, 320 * unit, 0, 3),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundTransparency = 0.82,
			BorderSizePixel = 0,
			ZIndex = 50,
			Parent = showContainer,
		})
		PillCorner(progressTrack)
		local progressFill = New("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = theme.Accent,
			BorderSizePixel = 0,
			ZIndex = 51,
			Parent = progressTrack,
		})
		PillCorner(progressFill)
		AccentGradient(progressFill, 0)

		local statusLabel = New("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -36 * unit),
			Size = UDim2.new(0, 460 * unit, 0, 16),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			Text = "SİNEMATİK GİRİŞ",
			TextColor3 = Color3.fromRGB(190, 200, 220),
			TextTransparency = 0.35,
			TextSize = math.floor(11 * unit),
			ZIndex = 50,
			Parent = showContainer,
		})

		New("TextLabel", {
			Position = UDim2.new(0, 26 * unit, 1, -34 * unit),
			Size = UDim2.fromOffset(240 * unit, 14),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = "AURORA UI  •  " .. self.Version,
			TextColor3 = Color3.fromRGB(255, 255, 255),
			TextTransparency = 0.55,
			TextSize = math.floor(10 * unit),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 50,
			Parent = showContainer,
		})

		local skipHint = New("TextLabel", {
			AnchorPoint = Vector2.new(1, 1),
			Position = UDim2.new(1, -26 * unit, 1, -34 * unit),
			Size = UDim2.fromOffset(250 * unit, 14),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			Text = "Atlamak için tıkla / SPACE",
			TextColor3 = Color3.fromRGB(255, 255, 255),
			TextTransparency = 0.6,
			TextSize = math.floor(10 * unit),
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 50,
			Parent = showContainer,
		})

		local video = nil
		local videoLoaded = false
		local videoDuration = tonumber(self.Options.IntroVideoDuration) or DEFAULT_VIDEO_DURATION
		local sequenceStarted = false
		local sequenceAt = math.huge

		-- video oluştur
		if asset then
			local okVideo, created = pcall(function()
				local frame = Instance.new("VideoFrame")
				frame.Name = "IntroVideo"
				frame.BackgroundTransparency = 1
				frame.BorderSizePixel = 0
				frame.Size = UDim2.fromScale(1, 1)
				frame.Looped = false
				frame.Volume = self.Options.IntroVideoVolume or 0.35
				frame.Video = asset
				frame.Parent = videoHolder
				return frame
			end)
			if okVideo and created then
				video = created
				loading.video = video
				pcall(function() video:Play() end)
			end
		end

		-- patlama
		local function explode()
			if loading.boomed or loading.finished then return end
			loading.boomed = true
			loading.phase = "explode"

			local currentViewport = Viewport()
			local center = UDim2.fromScale(0.5, 0.5)

			flash.BackgroundTransparency = 0
			Tween(flash, { BackgroundTransparency = 1 }, 0.55, EASE.Quad)

			ring.Visible = true
			ring.Position = center
			ring.Size = UDim2.fromOffset(40, 40)
			ringStroke.Transparency = 0.05
			ringStroke.Thickness = 8
			Tween(ring, { Size = UDim2.fromOffset(currentViewport.X * 2.6, currentViewport.X * 2.6) },
				0.75, EASE.Snappy, DIR.Out)
			Tween(ringStroke, { Transparency = 1, Thickness = 1 }, 0.7, EASE.Quad)

			Tween(bestGroup.scale, { Scale = 1.5 * unit }, 0.3)
			Tween(universalGroup.scale, { Scale = 1.35 * unit }, 0.3)
			Tween(scriptGroup.scale, { Scale = 1.45 * unit }, 0.3)
			FadeTextGroup(bestGroup, 1, 0.22)
			FadeTextGroup(universalGroup, 1, 0.22)
			FadeTextGroup(scriptGroup, 1, 0.22)

			for index = 1, 24 do
				local angle = (index / 24) * math.pi * 2 + math.random() * 0.2
				local length = math.random(60, 220) * unit
				local shard = New("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = center,
					Size = UDim2.fromOffset(length, math.random(2, 5) * unit),
					Rotation = math.deg(angle),
					BackgroundColor3 = (index % 2 == 0) and theme.Accent or theme.Accent2,
					BackgroundTransparency = 0.15,
					BorderSizePixel = 0,
					ZIndex = 57,
					Parent = shardLayer,
				})
				PillCorner(shard)
				local distance = math.random(220, 520) * unit
				Tween(shard, {
					Position = UDim2.fromOffset(
						currentViewport.X / 2 + math.cos(angle) * distance,
						currentViewport.Y / 2 + math.sin(angle) * distance
					),
					BackgroundTransparency = 1,
					Size = UDim2.fromOffset(length * 1.6, 1),
				}, 0.6 + math.random() * 0.25, EASE.Quint, DIR.Out)
			end

			for index = 1, 30 do
				local spark = New("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = center,
					Size = UDim2.fromOffset(4 * unit, 4 * unit),
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					BorderSizePixel = 0,
					ZIndex = 59,
					Parent = shardLayer,
				})
				PillCorner(spark)
				local angle = math.random() * math.pi * 2
				local distance = math.random(80, 460) * unit
				Tween(spark, {
					Position = UDim2.fromOffset(
						currentViewport.X / 2 + math.cos(angle) * distance,
						currentViewport.Y / 2 + math.sin(angle) * distance
					),
					BackgroundTransparency = 1,
					Size = UDim2.fromOffset(1, 1),
				}, 0.45 + math.random() * 0.35, EASE.Quad, DIR.Out)
			end

			local shakeSteps = 8
			for stepIndex = 1, shakeSteps do
				task.delay(stepIndex * 0.035, function()
					if loading.finished then return end
					local strength = math.floor((18 * unit) * (1 - stepIndex / shakeSteps))
					root.Position = UDim2.fromOffset(math.random(-strength, strength), math.random(-strength, strength))
				end)
			end
			task.delay(shakeSteps * 0.035, function()
				if root then root.Position = UDim2.fromOffset(0, 0) end
			end)

			Tween(letterTop, { Size = UDim2.new(1, 0, 0, 0) }, 0.5, EASE.Snappy, DIR.Out)
			Tween(letterBottom, {
				Position = UDim2.new(0, 0, 1, 0),
				Size = UDim2.new(1, 0, 0, 0),
			}, 0.5, EASE.Snappy, DIR.Out)

			if type(onFinish) == "function" then
				task.delay(at(0.12), function()
					pcall(onFinish)
				end)
			end

			task.delay(at(0.55), function()
				loading.finished = true
				if loading.ReleaseInput then loading.ReleaseInput() end
				Tween(showContainer, { GroupTransparency = 1 }, 0.45, EASE.Quad)
				Tween(root, { GroupTransparency = 1 }, 0.45, EASE.Quad)
				task.delay(0.5, function()
					pcall(function() gui:Destroy() end)
					if Library._loading == loading then
						Library._loading = nil
					end
				end)
			end)
		end

		-- yazı sekansı
		local sequenceBase = 0
		local function startSequence(forceNow)
			if sequenceStarted then return end
			sequenceStarted = true
			loading.phase = "sequence"
			sequenceBase = 0

			-- sinema bantlarını kapat (video varsa)
			Tween(letterTop, { Size = UDim2.new(1, 0, 0.085, 0) }, 0.6, EASE.Snappy, DIR.Out)
			Tween(letterBottom, {
				Position = UDim2.new(0, 0, 0.915, 0),
				Size = UDim2.new(1, 0, 0.085, 0),
			}, 0.6, EASE.Snappy, DIR.Out)

			-- BEST alttan
			step(0.15, function()
				bestGroup.group.Position = UDim2.fromScale(0.5, 0.78)
				bestGroup.scale.Scale = unit * 0.82
				FadeTextGroup(bestGroup, 0, 0.18)
				Tween(bestGroup.group, { Position = UDim2.fromScale(0.5, 0.59) }, 0.75, EASE.Snappy, DIR.Out)
				Tween(bestGroup.scale, { Scale = unit }, 0.75, EASE.Back, DIR.Out)
				Tween(bestGroup.glow, { TextColor3 = theme.Accent2 }, 0.4)
			end)

			-- BEST gider
			step(2.0, function()
				Tween(bestGroup.group, { Position = UDim2.fromScale(0.5, 0.35) }, 0.45, EASE.Quint, DIR.In)
				Tween(bestGroup.scale, { Scale = unit * 0.9 }, 0.45, EASE.Quint)
				FadeTextGroup(bestGroup, 1, 0.45)
			end)

			-- ekran bölünür
			step(2.45, function()
				seam.BackgroundTransparency = 0.25
				seamGlow.BackgroundTransparency = 0.75
				Tween(letterTop, { Size = UDim2.new(1, 0, 0.19, 0) }, 0.55, EASE.Snappy, DIR.InOut)
				Tween(letterBottom, {
					Position = UDim2.new(0, 0, 0.81, 0),
					Size = UDim2.new(1, 0, 0.19, 0),
				}, 0.55, EASE.Snappy, DIR.InOut)
				Tween(seam, { Size = UDim2.new(1, 0, 0, 2) }, 0.6, EASE.Snappy, DIR.Out)
				Tween(seamGlow, { Size = UDim2.new(1, 0, 0, 76 * unit) }, 0.6, EASE.Snappy, DIR.Out)
			end)

			-- UNIVERSAL + SCRIPT
			step(2.7, function()
				universalGroup.group.Position = UDim2.fromScale(0.5, 0.5 - 0.26)
				universalGroup.scale.Scale = unit * 1.05
				scriptGroup.group.Position = UDim2.fromScale(0.5, 0.5 + 0.26)
				scriptGroup.scale.Scale = unit * 1.05

				FadeTextGroup(universalGroup, 0, 0.2)
				FadeTextGroup(scriptGroup, 0, 0.2)

				Tween(universalGroup.group, { Position = UDim2.fromScale(0.5, 0.5 - 0.105) }, 0.65, EASE.Snappy, DIR.Out)
				Tween(scriptGroup.group, { Position = UDim2.fromScale(0.5, 0.5 + 0.105) }, 0.65, EASE.Snappy, DIR.Out)
				Tween(universalGroup.scale, { Scale = unit }, 0.6, EASE.Back, DIR.Out)
				Tween(scriptGroup.scale, { Scale = unit }, 0.6, EASE.Back, DIR.Out)
			end)

			-- enerji yükselir
			step(3.55, function()
				local pulse = TweenInfo.new(0.22, EASE.Sine, DIR.InOut, -1, true)
				pcall(function()
					TweenService:Create(seamGlow, pulse, { BackgroundTransparency = 0.35 }):Play()
					TweenService:Create(seam, pulse, { BackgroundTransparency = 0 }):Play()
					TweenService:Create(universalGroup.glow, pulse, { TextTransparency = 0.05 }):Play()
					TweenService:Create(scriptGroup.glow, pulse, { TextTransparency = 0.05 }):Play()
				end)
				for index = 1, 6 do
					task.delay(at(index * 0.16), function()
						if loading.cancelled or loading.finished then return end
						local strength = math.floor((3 + index * 1.4) * unit)
						root.Position = UDim2.fromOffset(math.random(-strength, strength), math.random(-strength, strength))
					end)
				end
			end)

			step(4.75, function()
				root.Position = UDim2.fromOffset(0, 0)
				explode()
			end)

			step(6.2, function()
				explode()
			end)
		end

		loading.StartSequence = function()
			startSequence(true)
		end

		-- video yüklendi mi? + ilerlemeyi izle (tekrar eden tick zinciri)
		local waited = 0
		local ticks = 0
		local maxWait = tonumber(self.Options.VideoLoadTimeout) or 8

		local function watchTick()
			if loading.cancelled or loading.finished then return end
			ticks = ticks + 1

			local loadedFlag = false
			local timeLength = 0
			local timePosition = 0
			if video then
				pcall(function()
					loadedFlag = video.IsLoaded == true
					timeLength = tonumber(video.TimeLength) or 0
					timePosition = tonumber(video.TimePosition) or 0
				end)
				if loadedFlag and not videoLoaded then
					videoLoaded = true
					Tween(fallback, { GroupTransparency = 1 }, 0.6, EASE.Quad)
					if timeLength > 1 then
						videoDuration = timeLength
					end
					sequenceAt = math.max(1.5, videoDuration - (self.Options.SequenceLead or 6.2))
					-- yükleme bitmeden çağrılan Play() bazen boşa gider: tekrar başlat
					pcall(function()
						if video.TimePosition > 0.15 then video.TimePosition = 0 end
						video:Play()
					end)
				end

				-- ilerleme çubuğu videonun gerçek zamanına bağlı
				if videoLoaded and not sequenceStarted and timeLength > 0 then
					local ratio = timePosition / timeLength
					if ratio < 0 then ratio = 0 elseif ratio > 1 then ratio = 1 end
					progressFill.Size = UDim2.fromScale(ratio, 1)
				end
			end

			if not videoLoaded then
				waited = waited + 0.1
				if waited >= maxWait then
					-- video yüklenemedi: animasyonlu arka planla devam
					loading.phase = "fallback"
					statusLabel.Text = "VİDEO YÜKLENEMEDİ  •  ARAYÜZ MODU"
					startSequence(true)
					return
				end
			elseif not sequenceStarted and timePosition >= sequenceAt then
				startSequence(false)
				return
			end

			if ticks < 3000 then
				task.delay(0.1, watchTick)
			end
		end
		watchTick()

		-- video yoksa çubuk zamanla dolar; varsa watchTick gerçek TimePosition'ı yazar
		progressFill.Size = UDim2.fromScale(0, 1)
		if not video then
			local track = Tween(progressFill, { Size = UDim2.fromScale(1, 1) }, at(6), EASE.Linear)
			if track then pcall(function() track:Pause() end) end
			task.delay(at(0.25), function()
				if track then pcall(function() track:Play() end) end
			end)
		end

		phaseObject = {
			explode = explode,
			startSequence = startSequence,
			isSequenceStarted = function() return sequenceStarted end,
			videoLoaded = function() return videoLoaded end,
		}
		return phaseObject
	end

	--==========================================================================
	-- FAZ GEÇİŞİ: indirme ekranı → video
	--==========================================================================
	local function startShowPhase(asset)
		loading.phase = "video"
		buildShowPhase(asset)
		Tween(showContainer, { GroupTransparency = 0 }, 0.45, EASE.Quad)
		Tween(downloadScreen.group, { GroupTransparency = 1 }, 0.35, EASE.Quad)
		task.delay(0.4, function()
			pcall(function() downloadScreen.group:Destroy() end)
		end)
	end

	--==========================================================================
	-- ATLAMA
	--==========================================================================
	local function skip()
		if loading.finished then return end
		if loading.phase == "download" then
			loading.skipDownload = true
			return
		end
		if not phaseObject then
			loading.skipVideo = true
			return
		end
		if loading.phase == "video" then
			loading.skipVideo = true
			phaseObject.startSequence()
			return
		end
		phaseObject.explode()
	end

	loading.Skip = skip
	loading.Destroy = function()
		loading.cancelled = true
		loading.finished = true
		if loading.ReleaseInput then loading.ReleaseInput() end
		pcall(function() gui:Destroy() end)
		if Library._loading == loading then
			Library._loading = nil
		end
	end

	-- giriş: tıkla / space / enter
	local inputConnection = Connect(Service("UserInputService").InputBegan, function(input)
		if loading.finished then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
			or input.KeyCode == Enum.KeyCode.Space
			or input.KeyCode == Enum.KeyCode.Return then
			skip()
		end
	end)
	loading.ReleaseInput = function()
		if inputConnection then
			pcall(function() inputConnection:Disconnect() end)
			inputConnection = nil
		end
	end

	pcall(function()
		local clickCatcher = New("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 55,
			Parent = root,
		})
		clickCatcher.MouseButton1Click:Connect(function()
			if loading.phase ~= "download" then
				skip()
			end
		end)
	end)

	--==========================================================================
	-- FAZ 1 AKIŞI: indirme
	--==========================================================================
	local useDownloadScreen = self.Options.DownloadScreen ~= false
	if not useDownloadScreen then
		downloadScreen.group.Visible = false
	end

	downloadScreen:SetStatus("Bağlantı kuruluyor...")
	downloadScreen:SetProgress(0, 1)

	task.spawn(function()
		local asset = nil
		local okResolve = pcall(function()
			asset = Library:_resolveIntroVideo(function(current, total, phase)
				if loading.cancelled or loading.finished then return end
				if phase == "cached" then
					downloadScreen:SetStatus("Önbellek bulundu  •  hazırlanıyor")
					downloadScreen:SetProgress(1, 1)
				elseif phase == "download-start" then
					downloadScreen:SetStatus("Video indiriliyor...")
				elseif phase == "download" then
					if total and total > 0 then
						downloadScreen:SetProgress(current, total)
						downloadScreen:SetStatus("Video indiriliyor... %" ..
							tostring(math.floor((current / total) * 100 + 0.5)))
					else
						downloadScreen:SetStatus("Video indiriliyor... " ..
							string.format("%.1f MB", (current or 0) / 1048576))
					end
				elseif phase == "write" then
					downloadScreen:SetStatus("Dosya yazılıyor...")
					downloadScreen:SetProgress(1, 1)
				end
			end)
		end)

		if loading.skipDownload and not asset then
			downloadScreen:SetStatus("İndirme atlandı  •  arayüz modu")
		end

		if loading.cancelled or loading.finished then return end

		if asset then
			downloadScreen:SetStatus("Hazır  •  sinematik başlıyor")
			downloadScreen:SetProgress(1, 1)
			task.wait(at(0.35))
			if loading.cancelled or loading.finished then return end
			startShowPhase(asset)
		else
			downloadScreen:SetStatus(Library._introVideoError or "Video kullanılamıyor  •  arayüz modu")
			task.wait(at(0.8))
			if loading.cancelled or loading.finished then return end
			startShowPhase(nil)
		end
	end)

	return loading
end

function Library:SkipLoadingScreen()
	local loading = self._loading
	if loading and loading.Skip then
		loading.Skip()
	end
end

