local function BuildCinematicText(parent, text, fontSize, zIndex)
	local group = New("Frame", {
		Name = "Text_" .. tostring(text),
		Size = UDim2.new(1, 0, 0, fontSize * 1.6),
		BackgroundTransparency = 1,
		ZIndex = zIndex or 20,
		Parent = parent,
	})
	local scale = New("UIScale", { Scale = 1, Parent = group })
	local layers = {}

	local function layer(color, transparency, dx, dy, strokeColor, strokeTransparency, strokeThickness, zOffset)
		local label = New("TextLabel", {
			Size = UDim2.fromScale(1, 1),
			Position = UDim2.fromOffset(dx or 0, dy or 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBlack,
			Text = SpacedText(text),
			TextColor3 = color,
			TextTransparency = transparency or 0,
			TextSize = fontSize,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			ZIndex = (zIndex or 20) + (zOffset or 0),
			Parent = group,
		})
		if strokeColor then
			New("UIStroke", {
				Color = strokeColor,
				Transparency = strokeTransparency or 0,
				Thickness = strokeThickness or 1,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
				Parent = label,
			})
		end
		table.insert(layers, label)
		return label
	end

	local chromaRed = layer(Color3.fromRGB(255, 70, 110), 0.78, -3, 0, nil, nil, nil, 0)
	local chromaCyan = layer(Color3.fromRGB(70, 220, 255), 0.78, 3, 0, nil, nil, nil, 0)
	local glow = layer(Color3.fromRGB(255, 255, 255), 0.72, 0, 0,
		Library.Theme.Accent, 0.45, 6, 1)
	local main = layer(Color3.fromRGB(255, 255, 255), 0, 0, 0,
		Color3.fromRGB(0, 0, 0), 0.5, 2, 2)

	return {
		group = group,
		scale = scale,
		main = main,
		glow = glow,
		chromaRed = chromaRed,
		chromaCyan = chromaCyan,
		layers = layers,
		setText = function(newText)
			for _, label in ipairs(layers) do
				label.Text = SpacedText(newText)
			end
		end,
	}
end

local function HideTextGroup(textGroup)
	for _, label in ipairs(textGroup.layers) do
		label.TextTransparency = 1
		for _, child in ipairs(label:GetChildren()) do
			if child:IsA("UIStroke") then child.Transparency = 1 end
		end
	end
end

local function FadeTextGroup(textGroup, targetAlpha, duration, easing)
	for _, label in ipairs(textGroup.layers) do
		local baseAlpha = 1
		if label == textGroup.chromaRed or label == textGroup.chromaCyan then
			baseAlpha = 0.22
		elseif label == textGroup.glow then
			baseAlpha = 0.28
		elseif label == textGroup.main then
			baseAlpha = 0
		end
		Tween(label, { TextTransparency = Clamp(targetAlpha + baseAlpha, 0, 1) }, duration or 0.3, easing)
		for _, child in ipairs(label:GetChildren()) do
			if child:IsA("UIStroke") then
				local strokeBase = (label == textGroup.glow) and 0.45 or 0.5
				Tween(child, { Transparency = Clamp(targetAlpha + strokeBase, 0, 1) }, duration or 0.3, easing)
			end
		end
	end
end

local function BuildAuroraBackdrop(parent)
	local theme = Library.Theme
	local backdrop = New("CanvasGroup", {
		Name = "Backdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		GroupTransparency = 0,
		Parent = parent,
	})

	New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(6, 8, 12),
		BorderSizePixel = 0,
		Parent = backdrop,
	})

	local blobConfig = {
		{ color = Color3.fromRGB(120, 60, 255), size = 0.75, x = 0.12, y = 0.15, transparency = 0.55 },
		{ color = Color3.fromRGB(0, 180, 220), size = 0.85, x = 0.82, y = 0.78, transparency = 0.6 },
		{ color = Color3.fromRGB(80, 40, 180), size = 0.6, x = 0.62, y = 0.2, transparency = 0.68 },
	}

	for index, config in ipairs(blobConfig) do
		local blob = New("Frame", {
			Name = "Blob" .. index,
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(config.x, config.y),
			Size = UDim2.fromScale(config.size, config.size),
			BackgroundColor3 = config.color,
			BackgroundTransparency = config.transparency,
			BorderSizePixel = 0,
			Parent = backdrop,
		})
		PillCorner(blob)
		New("UIGradient", {
			Color = ColorSequence.new(config.color, Color3.fromRGB(0, 0, 0)),
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Parent = blob,
		})
		New("UIStroke", { Color = config.color, Transparency = 0.85, Thickness = 40, Parent = blob })

		local drift = TweenInfo.new(6 + index * 2, EASE.Sine, DIR.InOut, -1, true)
		pcall(function()
			TweenService:Create(blob, drift, {
				Position = UDim2.fromScale(config.x + 0.12, config.y - 0.06),
				Size = UDim2.fromScale(config.size * 1.15, config.size * 1.15),
			}):Play()
		end)
	end

	for index = 1, 22 do
		local side = (index % 2 == 0) and theme.Accent or theme.Accent2
		local dot = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(math.random() * 1, math.random() * 1),
			Size = UDim2.fromOffset(math.random(2, 4), math.random(2, 4)),
			BackgroundColor3 = side,
			BackgroundTransparency = 0.4,
			BorderSizePixel = 0,
			Parent = backdrop,
		})
		PillCorner(dot)
		local travel = TweenInfo.new(4 + math.random() * 5, EASE.Linear, DIR.Out, -1, true)
		pcall(function()
			TweenService:Create(dot, travel, {
				Position = UDim2.fromScale(math.random() * 1, math.random() * 1),
				BackgroundTransparency = 0.85,
			}):Play()
		end)
	end

	return backdrop
end

