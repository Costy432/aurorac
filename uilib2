		-- video yüklenemedi / oynamadı → aurora moduna düş (asla takılı kalma)
		local function failToFallback(message)
			if loading.fallbackUsed or sequenceStarted then return end
			loading.fallbackUsed = true
			loading.phase = "fallback"
			if asset then
				-- bu executor yerel videoyu oynatamıyor: sonraki açılışta boşuna denemeyelim
				Library._videoUnsupported = true
			end
			if statusLabel then statusLabel.Text = message end
			pcall(function()
				print("[AuroraUI] " .. tostring(message) .. "  •  intro.mp4 oynatılamadı. "
					.. "Aurora moduna geçildi. (Detay: Library:IntroDiagnostics())")
			end)
			pcall(function() if video then video.Visible = false end end)
			if fallback then
				fallback.GroupTransparency = 0
			end
			startSequence(true)
		end

		-- video yüklendi mi? + ilerlemeyi izle (tekrar eden tick zinciri)
		local waited = 0
		local ticks = 0
		local stallTime = 0
		local lastPosition = -1
		local maxWait = tonumber(self.Options.VideoLoadTimeout) or 3.5
		local presetAsset = type(self.Options.IntroVideo) == "string" and self.Options.IntroVideo ~= ""
		if Library._videoUnsupported and not presetAsset then
			-- bu executor yerel videoyu daha önce oynatamadı: uzun süre bekleme
			maxWait = math.min(maxWait, 0.6)
		end
		local stallLimit = tonumber(self.Options.VideoStallTimeout) or 2.5

		local function watchTick()
			if loading.cancelled or loading.finished then return end
			ticks = ticks + 1

			local loadedFlag = false
			local timeLength = 0
			local timePosition = 0
			if flip then
				-- kare modu: her tick'te ilerle (0.1 s)
				flipElapsed = flipElapsed + 0.1
				local total = (flipMeta.count or 0)
				local index = math.floor(flipElapsed * (flipMeta.fps or 8))
				if total > 0 and index >= total then index = total - 1 end
				if index ~= flipFrame then
					flipFrame = index
					flipShow(index)
				end
				loadedFlag = true
				timeLength = videoDuration
				timePosition = math.min(flipElapsed, videoDuration)
			elseif video then
				pcall(function()
					loadedFlag = video.IsLoaded == true
					timeLength = tonumber(video.TimeLength) or 0
					timePosition = tonumber(video.TimePosition) or 0
				end)
			end

			-- ortak: kaynak (video veya kareler) hazır olduğunda
			if loadedFlag and not videoLoaded then
				videoLoaded = true
				Tween(fallback, { GroupTransparency = 1 }, 0.6, EASE.Quad)
				if timeLength > 1 then
					videoDuration = timeLength
				end
				sequenceAt = math.max(1.5, videoDuration - (self.Options.SequenceLead or 6.2))
				if video then
					-- yükleme bitmeden çağrılan Play() bazen boşa gider: tekrar başlat
					pcall(function()
						if video.TimePosition > 0.15 then video.TimePosition = 0 end
						video:Play()
					end)
				end
			end

			-- ilerleme çubuğu gerçek zamana bağlı (video TimePosition ya da kare saati)
			if videoLoaded and not sequenceStarted and timeLength > 0 then
				local ratio = timePosition / timeLength
				if ratio < 0 then ratio = 0 elseif ratio > 1 then ratio = 1 end
				progressFill.Size = UDim2.fromScale(ratio, 1)
			end

			if not videoLoaded then
				waited = waited + 0.1
				if waited >= maxWait then
					failToFallback("VİDEO YÜKLENEMEDİ  •  ARAYÜZ MODU")
					return
				end
			elseif not sequenceStarted then
				-- IsLoaded true olsa da kare gelmiyorsa (bozuk rbxasset yolu) zaman donar
				if timePosition > lastPosition + 0.001 then
					lastPosition = timePosition
					stallTime = 0
					loading.videoProgressing = true
				else
					stallTime = stallTime + 0.1
					if stallTime >= stallLimit then
						failToFallback("VİDEO OYNATILAMADI  •  ARAYÜZ MODU")
						return
					end
				end
				if timePosition >= sequenceAt then
					startSequence(false)
					return
				end
			end

			if ticks < 3000 then
				task.delay(0.1, watchTick)
			end
		end
		watchTick()

		-- video yoksa çubuk zamanla dolar; varsa watchTick gerçek TimePosition'ı yazar
		progressFill.Size = UDim2.fromScale(0, 1)
		if not video and not flip then
			local track = Tween(progressFill, { Size = UDim2.fromScale(1, 1) }, at(6), EASE.Linear)
			if track then pcall(function() track:Pause() end) end
			task.delay(at(0.25), function()
				if track then pcall(function() track:Play() end) end
			end)
		end

		phaseObject = {
			explode = explode,
			startSequence = startSequence,
			isSequenceStarted = function() return sequenceStarted end,
			videoLoaded = function() return videoLoaded end,
		}
		return phaseObject
	end

	--==========================================================================
	-- FAZ GEÇİŞİ: indirme ekranı → video
	--==========================================================================
	local function startShowPhase(source)
		if loading.showStarted then return end
		loading.showStarted = true
		loading.phase = "video"
		buildShowPhase(source)
		Tween(showContainer, { GroupTransparency = 0 }, 0.45, EASE.Quad)
		Tween(downloadScreen.group, { GroupTransparency = 1 }, 0.35, EASE.Quad)
		task.delay(0.4, function()
			pcall(function() downloadScreen.group:Destroy() end)
		end)
	end

	--==========================================================================
	-- ATLAMA
	--==========================================================================
	local function skip()
		if loading.finished then return end
		if loading.phase == "download" then
			loading.skipDownload = true
			return
		end
		if not phaseObject then
			loading.skipVideo = true
			return
		end
		if loading.phase == "video" then
			loading.skipVideo = true
			phaseObject.startSequence()
			return
		end
		phaseObject.explode()
	end

	loading.Skip = skip
	loading.Destroy = function()
		loading.cancelled = true
		loading.finished = true
		if loading.ReleaseInput then loading.ReleaseInput() end
		pcall(function() gui:Destroy() end)
		if Library._loading == loading then
			Library._loading = nil
		end
	end

	-- giriş: tıkla / space / enter
	local inputConnection = Connect(Service("UserInputService").InputBegan, function(input)
		if loading.finished then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch
			or input.KeyCode == Enum.KeyCode.Space
			or input.KeyCode == Enum.KeyCode.Return then
			skip()
		end
	end)
	loading.ReleaseInput = function()
		if inputConnection then
			pcall(function() inputConnection:Disconnect() end)
			inputConnection = nil
		end
	end

	pcall(function()
		local clickCatcher = New("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Text = "",
			ZIndex = 55,
			Parent = root,
		})
		clickCatcher.MouseButton1Click:Connect(function()
			if loading.phase ~= "download" then
				skip()
			end
		end)
	end)

	--==========================================================================
	-- FAZ 1 AKIŞI: indirme
	--==========================================================================
	local useDownloadScreen = self.Options.DownloadScreen ~= false
	if not useDownloadScreen then
		downloadScreen.group.Visible = false
	end

	downloadScreen:SetStatus("Bağlantı kuruluyor...")
	downloadScreen:SetProgress(0, 1)

	-- GÜVENCE: ağ takılsa da, video donup kalsa da panel her koşulda açılır
	local hardCap = tonumber(self.Options.LoadingTimeout) or 12
	if hardCap > 0 then
		task.delay(at(hardCap), function()
			if loading.cancelled or loading.finished or loading.boomed then return end
			-- video gerçekten oynuyorsa karışma: 19 s'lik klip kırpılmasın
			if loading.videoProgressing then return end
			if not loading.showStarted then
				loading.downloadTimedOut = true
				startShowPhase(nil)
			end
			if phaseObject and not phaseObject.isSequenceStarted() then
				phaseObject.startSequence(true)
			end
			task.delay(at(5.6), function()
				if loading.cancelled or loading.finished or loading.boomed then return end
				if phaseObject then phaseObject.explode() end
			end)
		end)
	end

	task.spawn(function()
		local asset = nil
		local source = nil

		-- 1) GÖMÜLÜ KARELER (dosyanın içinde, ağ gerekmez) → her zaman çalışır
		local allowEmbedded = self.Options.UseEmbeddedFrames ~= false
		if allowEmbedded and Library._EmbeddedFrames and not source then
			downloadScreen:SetStatus("Kareler hazırlanıyor...")
			local okEmbed, embedMeta = pcall(Library.UnpackEmbeddedFrames, Library, function(current, total)
				if loading.cancelled or loading.finished then return end
				if total and total > 0 then
					downloadScreen:SetProgress(current, total)
					downloadScreen:SetStatus("Kareler hazırlanıyor... " .. tostring(current) .. "/" .. tostring(total))
				end
			end)
			if okEmbed and type(embedMeta) == "table" then
				source = { kind = "frames", meta = embedMeta }
				loading.frameSource = "embedded"
			else
				Library._introFramesError = tostring(embedMeta or "gömülü kareler açılamadı")
			end
		end

		-- 2) Gömülü yoksa: GitHub'dan atlas indir
		if not source and type(self.Options.IntroFramesUrl) == "string" and self.Options.IntroFramesUrl ~= "" then
			downloadScreen:SetStatus("Kareler indiriliyor...")
			local okFrames, framesMeta = pcall(Library._resolveIntroFrames, Library, function(current, total, phase)
				if loading.cancelled or loading.finished then return end
				if phase == "cached" then return end
				if total and total > 0 then
					downloadScreen:SetProgress(current, total)
					downloadScreen:SetStatus("Kareler indiriliyor... " .. tostring(current) .. "/" .. tostring(total))
				end
			end)
			if okFrames and type(framesMeta) == "table" then
				source = { kind = "frames", meta = framesMeta }
				loading.frameSource = "github"
				downloadScreen:SetStatus("Dosyalar yazılıyor...")
				downloadScreen:SetProgress(1, 1)
			else
				Library._introFramesError = tostring(framesMeta or "kareler alınamadı")
			end
		end

		-- 2) Kare yoksa: klasik video (rbxassetid) / GitHub mp4 indirme
		if not source then
		local okResolve = pcall(function()
			asset = Library:_resolveIntroVideo(function(current, total, phase)
				if loading.cancelled or loading.finished then return end
				if phase == "cached" then
					downloadScreen:SetStatus("Önbellek bulundu  •  hazırlanıyor")
					downloadScreen:SetProgress(1, 1)
				elseif phase == "download-start" then
					downloadScreen:SetStatus("Video indiriliyor...")
				elseif phase == "download" then
					if total and total > 0 then
						downloadScreen:SetProgress(current, total)
						downloadScreen:SetStatus("Video indiriliyor... %" ..
							tostring(math.floor((current / total) * 100 + 0.5)))
					else
						downloadScreen:SetStatus("Video indiriliyor... " ..
							string.format("%.1f MB", (current or 0) / 1048576))
					end
				elseif phase == "write" then
					downloadScreen:SetStatus("Dosya yazılıyor...")
					downloadScreen:SetProgress(1, 1)
				end
			end)
		end)

		if not source and asset then
			source = asset
		end
		end

		if loading.skipDownload and not source then
			downloadScreen:SetStatus("İndirme atlandı  •  arayüz modu")
		end

		if loading.cancelled or loading.finished or loading.showStarted then return end

		if source then
			downloadScreen:SetStatus("Hazır  •  sinematik başlıyor")
			downloadScreen:SetProgress(1, 1)
			task.wait(at(0.35))
			if loading.cancelled or loading.finished then return end
			startShowPhase(source)
		else
			downloadScreen:SetStatus(Library._introVideoError or "Video kullanılamıyor  •  arayüz modu")
			task.wait(at(0.8))
			if loading.cancelled or loading.finished then return end
			startShowPhase(nil)
		end
	end)

	return loading
end

--- Executor'da video akışının nerede takıldığını gösterir.
--- Örn: print(Library:IntroDiagnostics())
function Library:IntroDiagnostics()
	local function has(name)
		return type(ExecutorFn(name)) == "function"
	end
	return {
		writefile = has("writefile"),
		isfile = has("isfile"),
		getfilesize = has("getfilesize"),
		makefolder = has("makefolder"),
		getcustomasset = has("getcustomasset"),
		http = RequestRaw ~= nil,
		file = self.Options.IntroVideoFile,
		bytes = self._introVideoBytes,
		asset = self._introVideoAsset,
		error = self._introVideoError,
		videoUnsupported = self._videoUnsupported == true,
	}
end

function Library:SkipLoadingScreen()
	local loading = self._loading
	if loading and loading.Skip then
		loading.Skip()
	end
end

