local MIN_VIDEO_BYTES = 4096
local DEFAULT_VIDEO_DURATION = 19.28

local function SpacedText(text, gap)
	if text == nil then return "" end
	text = tostring(text)
	if #text <= 1 then return text end
	local parts = {}
	for index = 1, #text do
		parts[#parts + 1] = string.sub(text, index, index)
	end
	return table.concat(parts, gap or " ")
end

local function PickGuiParent()
	if type(gethui) == "function" then
		local ok, hidden = pcall(gethui)
		if ok and hidden then return hidden end
	end
	local coreGui = Service("CoreGui")
	if coreGui then
		local ok = pcall(function() return #coreGui:GetChildren() end)
		if ok then return coreGui end
	end
	local players = Service("Players")
	local player = players and players.LocalPlayer
	if player then
		local ok, playerGui = pcall(function() return player:FindFirstChild("PlayerGui") end)
		if ok and playerGui then return playerGui end
	end
	return nil
end

-- Executor uyumlu HTTP isteği (header destekleyenleri önce dener)
local function RequestRaw(url, headers)
	if type(url) ~= "string" or url == "" then return nil end

	local candidates = {}
	if syn and type(syn.request) == "function" then
		table.insert(candidates, function(opts) return syn.request(opts) end)
	end
	if http and type(http.request) == "function" then
		table.insert(candidates, function(opts) return http.request(opts) end)
	end
	if type(http_request) == "function" then
		table.insert(candidates, function(opts) return http_request(opts) end)
	end
	if type(request) == "function" then
		table.insert(candidates, function(opts) return request(opts) end)
	end

	for _, fetch in ipairs(candidates) do
		local ok, response = pcall(fetch, {
			Url = url,
			Method = "GET",
			Headers = headers or {},
		})
		if ok and type(response) == "table" and type(response.Body) == "string" and #response.Body > 0 then
			return {
				Body = response.Body,
				Headers = response.Headers or response.headers or {},
				StatusCode = response.StatusCode or response.StatusCode,
			}
		end
	end

	-- Header gerekmeyen tek parça indirme (Range yoksa)
	if not headers or next(headers) == nil then
		local ok, body = pcall(function() return game:HttpGet(url, true) end)
		if ok and type(body) == "string" and #body > 0 then
			return { Body = body, Headers = {}, StatusCode = 200 }
		end
	end
	return nil
end

local function HeaderValue(headers, key)
	if type(headers) ~= "table" then return nil end
	local wanted = string.lower(key)
	for name, value in pairs(headers) do
		if string.lower(tostring(name)) == wanted then
			return tostring(value)
		end
	end
	return nil
end

local function FolderExists(path)
	if type(isfolder) ~= "function" then return false end
	local ok, exists = pcall(isfolder, path)
	return ok and exists == true
end

local function EnsureFolder(filePath)
	if type(makefolder) ~= "function" then return end
	local folder = string.match(filePath, "^(.*)/[^/]+$")
	if not folder or folder == "" then return end
	if FolderExists(folder) then return end
	-- iç içe klasörleri sırayla oluştur
	local built = ""
	for part in string.gmatch(folder, "[^/]+") do
		built = (built == "") and part or (built .. "/" .. part)
		if not FolderExists(built) then
			pcall(makefolder, built)
		end
	end
end

--- Videoyu executor'ın workspace'ine indirir.
-- @return ok:boolean, pathOrError:string, bytes:number
function Library:DownloadIntroVideo(progressCallback)
	local path = self.Options.IntroVideoFile or "AuroraUI/intro.mp4"
	local url = self.Options.IntroVideoUrl

	if type(isfile) == "function" then
		local okFile, exists = pcall(isfile, path)
		if okFile and exists then
			local size = 0
			if type(getfilesize) == "function" then
				local okSize, result = pcall(getfilesize, path)
				if okSize and type(result) == "number" then size = result end
			end
			if size >= MIN_VIDEO_BYTES or (size == 0 and type(getfilesize) ~= "function") then
				if progressCallback then progressCallback(-1, -1, "cached") end
				return true, path, size
			end
		end
	end

	if type(url) ~= "string" or url == "" then
		return false, "IntroVideoUrl boş"
	end
	if type(writefile) ~= "function" then
		return false, "Executor writefile desteklemiyor"
	end

	local chunkSize = tonumber(self.Options.IntroVideoChunkSize) or (512 * 1024)
	if chunkSize < 65536 then chunkSize = 65536 end

	local totalBytes = nil
	local chunks = {}
	local downloaded = 0
	local useRange = true

	-- 1) Parça parça indirme (gerçek ilerleme yüzdesi)
	while useRange do
		local from = downloaded
		local to = downloaded + chunkSize - 1
		local response = RequestRaw(url, { ["Range"] = string.format("bytes=%d-%d", from, to) })
		if not response then
			useRange = false
			break
		end

		local contentRange = HeaderValue(response.Headers, "content-range")
		if contentRange then
			local total = string.match(contentRange, "/(%d+)")
			if total then totalBytes = tonumber(total) end
		elseif downloaded == 0 then
			local contentLength = HeaderValue(response.Headers, "content-length")
			if contentLength then totalBytes = tonumber(contentLength) end
		end

		table.insert(chunks, response.Body)
		downloaded = downloaded + #response.Body

		if progressCallback then
			progressCallback(downloaded, totalBytes, "download")
		end

		if #response.Body < chunkSize then
			break
		end
		if totalBytes and downloaded >= totalBytes then
			break
		end
		if #chunks > 128 then
			break
		end
	end

	local body = (#chunks > 0) and table.concat(chunks) or nil

	-- 2) Tek parça indirme (Range desteklenmiyorsa)
	if not body or #body < MIN_VIDEO_BYTES then
		if progressCallback then progressCallback(0, nil, "download-start") end
		local response = RequestRaw(url)
		if response and #response.Body >= MIN_VIDEO_BYTES then
			body = response.Body
			if progressCallback then progressCallback(#body, #body, "download") end
		else
			return false, "Video indirilemedi (ağ / executor engeli)"
		end
	end

	EnsureFolder(path)

	if progressCallback then progressCallback(#body, #body, "write") end
	local written, writeErr = pcall(writefile, path, body)
	if not written then
		return false, "Dosya yazılamadı: " .. tostring(writeErr)
	end

	self._introVideoBytes = #body
	return true, path, #body
end

--- Varsa hazır asset'i, yoksa indirip getcustomasset ile asset'e çevirir.
function Library:_resolveIntroVideo(progressCallback)
	local preset = self.Options.IntroVideo
	if type(preset) == "string" and preset ~= "" then
		return preset
	end
	if self._introVideoAsset ~= nil then
		return self._introVideoAsset or nil
	end

	if type(getcustomasset) ~= "function" then
		self._introVideoAsset = false
		return nil
	end

	local okDownload, pathOrError = self:DownloadIntroVideo(progressCallback)
	if not okDownload then
		self._introVideoAsset = false
		self._introVideoError = tostring(pathOrError)
		return nil
	end

	local okAsset, asset = pcall(getcustomasset, pathOrError)
	if okAsset and type(asset) == "string" and asset ~= "" then
		self._introVideoAsset = asset
		return asset
	end

	self._introVideoAsset = false
	self._introVideoError = "getcustomasset başarısız"
	return nil
end

