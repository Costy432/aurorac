-- ELEMAN: BUTTON
--=============================================================================
CardAddButton = function(card, text, callback, opts)
	opts = opts or {}
	local theme = Library.Theme
	local element = ElementBase(card, text, 32)
	local frame = element.Frame
	element._kind = "button"

	local button = New("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = theme.Element,
		BackgroundTransparency = 0.2,
		Text = "",
		AutoButtonColor = false,
		ClipsDescendants = true,
		Parent = frame,
	})
	Corner(button, 8)
	local buttonStroke = Stroke(button, theme.Stroke, 0.9)

	local label = New("TextLabel", {
		Position = UDim2.new(0, 12, 0, 0),
		Size = UDim2.new(1, -40, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = tostring(text),
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = button,
	})

	local chevron = MakeChevron(button, 9, theme.Muted, "right", 1.5)
	chevron.AnchorPoint = Vector2.new(1, 0.5)
	chevron.Position = UDim2.new(1, -10, 0.5, 0)

	if opts.Icon then
		local icon = Icons.Render(button, opts.Icon, theme.SubText, 13)
		icon.AnchorPoint = Vector2.new(0, 0.5)
		icon.Position = UDim2.new(0, 11, 0.5, 0)
		label.Position = UDim2.new(0, 32, 0, 0)
		label.Size = UDim2.new(1, -60, 1, 0)
		element._icon = icon
	end

	button.MouseEnter:Connect(function()
		Tween(button, { BackgroundTransparency = 0.02 }, 0.16)
		Tween(buttonStroke, { Transparency = 0.72, Color = theme.Accent }, 0.16)
		Tween(label, { TextColor3 = Color3.fromRGB(255, 255, 255) }, 0.16)
	end)
	button.MouseLeave:Connect(function()
		Tween(button, { BackgroundTransparency = 0.2 }, 0.16)
		Tween(buttonStroke, { Transparency = 0.9, Color = theme.Stroke }, 0.16)
		Tween(label, { TextColor3 = theme.Text }, 0.16)
	end)

	local baseText = tostring(text)
	local confirming = false
	local confirmToken = 0

	local function resetConfirm()
		confirming = false
		label.Text = baseText
		Tween(label, { TextColor3 = theme.Text }, 0.15)
		Tween(buttonStroke, { Transparency = 0.9, Color = theme.Stroke }, 0.15)
	end

	button.MouseButton1Click:Connect(function()
		if opts.Confirm then
			if not confirming then
				confirming = true
				confirmToken = confirmToken + 1
				local token = confirmToken
				label.Text = opts.ConfirmText or "Onaylamak için tekrar tıkla"
				label.TextColor3 = theme.Warning
				Tween(buttonStroke, { Transparency = 0.55, Color = theme.Warning }, 0.15)
				task.delay(2, function()
					if confirming and token == confirmToken then
						resetConfirm()
					end
				end)
				return
			end
			resetConfirm()
		end
		Ripple(button)
		SafeCallback(callback)
	end)

	function element:SetText(newText)
		baseText = tostring(newText)
		if not confirming then
			label.Text = baseText
		end
	end

	card:_refresh()
	return element
end

--=============================================================================
-- ELEMAN: SLIDER
--=============================================================================
CardAddSlider = function(card, text, opts, callback)
	opts = opts or {}
	local theme = Library.Theme

	local minValue = opts.Min or 0
	local maxValue = opts.Max or 100
	if maxValue <= minValue then
		maxValue = minValue + 1
	end
	local step = opts.Step or 1
	local decimals = opts.Decimals or DecimalsOf(step)
	local suffix = opts.Suffix or ""
	local height = 44

	local element = ElementBase(card, text, height)
	local frame = element.Frame
	element._kind = "slider"

	New("TextLabel", {
		Position = UDim2.new(0, 0, 0, 0),
		Size = UDim2.new(1, -80, 0, 17),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = tostring(text),
		TextColor3 = theme.Text,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
		Parent = frame,
	})

	local valueBadge = New("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(56, 18),
		BackgroundColor3 = theme.Element,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamMedium,
		Text = "",
		TextColor3 = theme.Text,
		TextSize = 11,
		Parent = frame,
	})
	Corner(valueBadge, 6)

	local track = New("Frame", {
		Position = UDim2.new(0, 0, 0, 31),
		Size = UDim2.new(1, 0, 0, 5),
		BackgroundColor3 = theme.Element,
		BorderSizePixel = 0,
		Parent = frame,
	})
	PillCorner(track)

	local fill = New("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = theme.Accent,
		BorderSizePixel = 0,
		Parent = track,
	})
	PillCorner(fill)
	AccentGradient(fill, 0)

	local knob = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BorderSizePixel = 0,
		Parent = track,
	})
	PillCorner(knob)
	New("UIStroke", {
		Color = theme.Accent,
		Transparency = 0.1,
		Thickness = 1.6,
		Parent = knob,
	})

	local hit = New("TextButton", {
		Position = UDim2.new(0, -4, 0, 21),
		Size = UDim2.new(1, 8, 0, 22),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		Parent = frame,
	})

	local value = nil

	local function apply(newValue, silent)
		newValue = Clamp(RoundTo(newValue, step), minValue, maxValue)
		local unchanged = (value ~= nil and math.abs(newValue - value) < 0.0000001)
		value = newValue
		local percent = (value - minValue) / (maxValue - minValue)
		fill.Size = UDim2.fromScale(percent, 1)
		knob.Position = UDim2.new(percent, 0, 0.5, 0)
		valueBadge.Text = FormatNumber(value, decimals) .. suffix
		if not silent and not unchanged then
			SafeCallback(callback, value)
		end
	end

	local function updateFromInput(input)
		local trackPos = track.AbsolutePosition
		local trackSize = track.AbsoluteSize
		local percent = Clamp((input.Position.X - trackPos.X) / math.max(trackSize.X, 1), 0, 1)
		apply(minValue + (maxValue - minValue) * percent, false)
	end

	Connect(hit.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			Library._sliderActive = element
			updateFromInput(input)
			Tween(knob, { Size = UDim2.fromOffset(17, 17) }, 0.15)
		end
	end)

	Connect(UserInputService.InputChanged, function(input)
		if Library._sliderActive ~= element then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			updateFromInput(input)
		end
	end)

	Connect(UserInputService.InputEnded, function(input)
		if Library._sliderActive == element then
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				Library._sliderActive = nil
				Tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.15)
			end
		end
	end)

	hit.MouseEnter:Connect(function()
		Tween(knob, { Size = UDim2.fromOffset(16, 16) }, 0.15)
	end)
	hit.MouseLeave:Connect(function()
		if Library._sliderActive ~= element then
			Tween(knob, { Size = UDim2.fromOffset(14, 14) }, 0.15)
		end
	end)

	function element:Set(newValue, silent)
		apply(newValue, silent == true)
	end

	function element:Get()
		return value
	end

	apply(opts.Default or minValue, true)

	local flag = opts.Flag or tostring(text)
	if flag then
		Library._flags[flag] = element
	end

	card:_refresh()
	return element
end

