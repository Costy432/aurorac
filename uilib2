local Icons = {}

local function MakeX(parent, size, color, thickness)
	local holder = New("Frame", {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local barThickness = thickness or math.max(1.2, size / 9)
	local first = New("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size * 0.8, barThickness),
		Rotation = 45,
		BackgroundColor3 = color or Library.Theme.SubText,
		BorderSizePixel = 0,
		Parent = holder,
	})
	PillCorner(first)
	local second = first:Clone()
	second.Rotation = -45
	second.Parent = holder
	return holder
end

local function MakeChevron(parent, size, color, direction, thickness)
	local holder = New("Frame", {
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	local barThickness = thickness or math.max(1.2, size / 7)
	local leftBar = New("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(0.55, 0, 0.5, 0),
		Size = UDim2.fromOffset(size * 0.55, barThickness),
		Rotation = 45,
		BackgroundColor3 = color or Library.Theme.SubText,
		BorderSizePixel = 0,
		Parent = holder,
	})
	PillCorner(leftBar)
	local rightBar = leftBar:Clone()
	rightBar.AnchorPoint = Vector2.new(0, 0.5)
	rightBar.Position = UDim2.new(0.45, 0, 0.5, 0)
	rightBar.Rotation = -45
	rightBar.Parent = holder
	if direction == "right" then
		holder.Rotation = -90
	elseif direction == "left" then
		holder.Rotation = 90
	elseif direction == "up" then
		holder.Rotation = 180
	end
	return holder
end

function Icons.Render(parent, name, color, size)
	size = size or 18
	color = color or Library.Theme.Text

	local holder = New("Frame", {
		Name = "Icon",
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
		Parent = parent,
	})

	if type(name) == "string" and string.sub(name, 1, 13) == "rbxassetid://" then
		New("ImageLabel", {
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			Image = name,
			ImageColor3 = color,
			Parent = holder,
		})
		return holder
	end

	local u = size / 18

	local function px(value)
		return value * u
	end

	local function part(x, y, w, h, radius, rotation, transparency)
		local frame = New("Frame", {
			Position = UDim2.fromOffset(px(x), px(y)),
			Size = UDim2.fromOffset(px(w), px(h)),
			BackgroundColor3 = color,
			BackgroundTransparency = transparency or 0,
			BorderSizePixel = 0,
			Rotation = rotation or 0,
			Parent = holder,
		})
		if radius and radius > 0 then
			Corner(frame, radius * u)
		end
		return frame
	end

	local function seg(x1, y1, x2, y2, thickness, radius)
		local dx = px(x2 - x1)
		local dy = px(y2 - y1)
		local length = math.sqrt(dx * dx + dy * dy)
		local angle = math.deg(atan2(dy, dx))
		local frame = New("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(px((x1 + x2) / 2), px((y1 + y2) / 2)),
			Size = UDim2.fromOffset(length, px(thickness or 1.8)),
			Rotation = angle,
			BackgroundColor3 = color,
			BorderSizePixel = 0,
			Parent = holder,
		})
		PillCorner(frame)
		return frame
	end

	local function ring(x, y, diameter, thickness)
		local frame = New("Frame", {
			Position = UDim2.fromOffset(px(x), px(y)),
			Size = UDim2.fromOffset(px(diameter), px(diameter)),
			BackgroundTransparency = 1,
			Parent = holder,
		})
		PillCorner(frame)
		New("UIStroke", {
			Color = color,
			Thickness = px(thickness or 1.8),
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = frame,
		})
		return frame
	end

	if name == "grid" then
		for row = 0, 1 do
			for col = 0, 1 do
				part(1 + col * 9, 1 + row * 9, 7, 7, 2.2)
			end
		end
	elseif name == "home" then
		part(3, 8.4, 12, 7.6, 1.8)
		part(4.6, 3.4, 8.8, 8.8, 1.4, 45)
	elseif name == "sliders" then
		local rows = { { y = 3.2, knob = 11.6 }, { y = 8.2, knob = 6.4 }, { y = 13.2, knob = 9.2 } }
		for _, row in ipairs(rows) do
			part(1, row.y, 16, 1.6, 0.8)
			local knob = ring(row.knob - 2.6, row.y - 1.6, 4.9, 1.6)
			knob.ZIndex = holder.ZIndex + 1
		end
	elseif name == "bolt" then
		seg(11.8, 2.2, 7.2, 9.4, 3.3)
		seg(9.2, 8.6, 4.8, 15.6, 3.3)
	elseif name == "sparkle" then
		part(5.4, 5.4, 7.2, 7.2, 1.4, 45)
		part(12.2, 2.2, 3.8, 3.8, 0.9, 45)
		part(2.2, 12.2, 3.2, 3.2, 0.8, 45)
	elseif name == "layers" then
		part(1, 2.2, 16, 4.6, 1.6)
		part(2.6, 7.6, 12.8, 4.6, 1.6, 0, 0.25)
		part(4.2, 13, 9.6, 3.6, 1.4, 0, 0.5)
	elseif name == "code" then
		seg(7.4, 4.2, 3.6, 9, 1.8)
		seg(3.6, 9, 7.4, 13.8, 1.8)
		seg(10.6, 4.2, 14.4, 9, 1.8)
		seg(14.4, 9, 10.6, 13.8, 1.8)
	elseif name == "user" then
		part(5.9, 2, 6.4, 6.4, 3.2)
		part(3.4, 11.2, 11.2, 4.8, 2.4)
	elseif name == "list" then
		for i = 0, 2 do
			local y = 3.4 + i * 5
			part(1.4, y + 0.4, 2.4, 2.4, 1.2)
			part(6.2, y, 10.6, 2.4, 1.2, 0, 0.15)
		end
	elseif name == "lock" then
		part(4.4, 7.6, 9.2, 8.4, 2)
		ring(6.1, 2, 5.8, 1.6)
	elseif name == "power" then
		ring(3, 3.6, 12, 1.8)
		part(8.1, 1.6, 1.8, 6.4, 0.9)
	elseif name == "check" then
		seg(3.6, 9.6, 7.4, 13.4, 2.2)
		seg(7.4, 13.4, 14.4, 4.6, 2.2)
	elseif name == "plus" then
		seg(9, 3.6, 9, 14.4, 1.9)
		seg(3.6, 9, 14.4, 9, 1.9)
	elseif name == "search" then
		ring(2.2, 2.2, 11, 1.8)
		seg(12.4, 12.4, 15.6, 15.6, 2.1)
	elseif name == "dot" then
		ring(2.6, 2.6, 12.8, 1.6)
		part(7.4, 7.4, 3.2, 3.2, 1.6)
	elseif name == "close" then
		seg(5, 5, 13, 13, 1.9)
		seg(13, 5, 5, 13, 1.9)
	elseif name == "minus" then
		seg(4, 9, 14, 9, 1.9)
	else
		part(7, 7, 4, 4, 2)
	end

	return holder
end

