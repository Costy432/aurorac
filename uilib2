--=============================================================================
local function HideTooltip()
	local tooltip = Library._tooltip
	if not tooltip then return end
	Library._tooltip = nil
	Tween(tooltip, { GroupTransparency = 1 }, 0.16, EASE.Quad)
	task.delay(0.2, function()
		if tooltip then tooltip:Destroy() end
	end)
end

local function ShowTooltip(anchor, text)
	HideTooltip()
	if not Library._root then return end

	local width = 84
	pcall(function()
		width = TextService:GetTextSize(text, 12, Enum.Font.GothamMedium, Vector2.new(400, 60)).X + 22
	end)

	local group = New("CanvasGroup", {
		Name = "AuroraTooltip",
		AnchorPoint = Vector2.new(0, 0.5),
		BackgroundTransparency = 1,
		GroupTransparency = 1,
		Size = UDim2.fromOffset(width, 26),
		ZIndex = 600,
		Parent = Library._root,
	})

	local absPos = anchor.AbsolutePosition
	local absSize = anchor.AbsoluteSize
	group.Position = UDim2.fromOffset(absPos.X + absSize.X + 8, absPos.Y + absSize.Y / 2)

	local bg = New("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Library.Theme.Panel,
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		Parent = group,
	})
	Corner(bg, 7)
	Stroke(bg, Library.Theme.Separator, 0.35)

	New("TextLabel", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		Text = text,
		TextColor3 = Library.Theme.Text,
		TextSize = 12,
		Parent = bg,
	})

	Library._tooltip = group
	Tween(group, { GroupTransparency = 0 }, 0.18, EASE.Quad)
end

