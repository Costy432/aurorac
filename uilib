local function new(class, props, parent)
    local i = Instance.new(class)
    for k, v in next, props or {} do i[k] = v end
    if parent then i.Parent = parent end
    return i
end
local function corner(p, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 4)}, p) end
local function stroke(p, c, t)
    return new("UIStroke", {Color = c or C.Border, Thickness = t or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, p)
end

local function dragify(frame, handle)
    handle = handle or frame
    local dragging, startInput, startPos, dragInput
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging   = true
            startInput = input
            startPos   = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local d = input.Position - startInput.Position
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

-- Tooltip (basit)
local tooltipFrame
local function showTooltip(text, pos)
    if not GuiLibrary.ToggleTooltips then return end
    if not tooltipFrame then
        tooltipFrame = new("TextLabel", {
            BackgroundColor3 = C.BgDark, BorderSizePixel = 0,
            Font = FONT, TextSize = 14, TextColor3 = C.TextDim,
            Size = UDim2.new(0, 0, 0, 26),
            ZIndex = 50, Visible = false,
        }, GuiLibrary.MainGui.ScaledGui)
        corner(tooltipFrame)
        stroke(tooltipFrame)
        new("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, tooltipFrame)
    end
    tooltipFrame.Text = text
    tooltipFrame.Size = UDim2.new(0, #text * 8 + 20, 0, 26)
    tooltipFrame.Position = UDim2.new(0, pos.X + 16, 0, pos.Y - 30)
    tooltipFrame.Visible = true
end
local function hideTooltip() if tooltipFrame then tooltipFrame.Visible = false end end

