local Window = {}
Window.__index = Window

function Window.new(name, opts)
    local self = setmetatable({}, Window)
    self.Name    = name
    self.Options = opts or {}
    self.Visible = false

    local frame = new("Frame", {
        Name = name .. "Window",
        BackgroundColor3 = C.Bg,
        BorderSizePixel  = 0,
        Size             = UDim2.new(0, 217, 0, 100),
        Position         = self.Options.Position or UDim2.new(0, 223, 0, 6),
        Visible          = false,
        ClipsDescendants = true,
    }, clickGui)
    corner(frame)
    stroke(frame)
    self.Frame = frame

    local titleBar = new("Frame", {
        Name = "TitleBar", BackgroundColor3 = C.Element,
        BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 30),
    }, frame)
    corner(titleBar)
    self.TitleBar = titleBar

    if self.Options.Icon then
        new("ImageLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(0, self.Options.IconSize or 15, 0, self.Options.IconSize or 15),
            Position = UDim2.new(0, 9, 0, (30 - (self.Options.IconSize or 15)) / 2),
            Image = self.Options.Icon, ImageColor3 = C.Text,
        }, titleBar)
    end
    new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, self.Options.Icon and 31 or 10, 0, 0),
        Size = UDim2.new(1, -40, 0, 30),
        Font = FONT, TextSize = 17, TextColor3 = C.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = name,
    }, titleBar)

    local content = new("ScrollingFrame", {
        Name = "Content", BackgroundTransparency = 1,
        BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 32),
        Size = UDim2.new(1, 0, 1, -34),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 2, ScrollBarImageColor3 = C.Border,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
    }, frame)
    local layout = new("UIListLayout", {
        Padding = UDim.new(0, 3),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, content)
    new("UIPadding", {
        PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 4),
    }, content)
    self.Content = content

    dragify(frame, titleBar)

    GuiLibrary.ObjectsThatCanBeSaved[name .. "Window"] = {
        Type = "Window", Object = frame, Api = self, SortOrder = #GuiLibrary.ObjectsThatCanBeSaved,
    }
    return self
end

function Window:SetVisible(v)
    self.Visible = v
    self.Frame.Visible = v
    if v then
        task.defer(function()
            local h = self.Content.UIListLayout.AbsoluteContentSize.Y + 40
            self.Frame.Size = UDim2.new(0, 217, 0, math.clamp(h, 39, 500))
        end)
    end
    GuiLibrary.UpdateHudEvent:Fire()
end

-- Toggle
function Window:CreateToggle(opts)
    opts = opts or {}
    local row = new("TextButton", {
        Name = opts.Name .. "Toggle",
        BackgroundColor3 = C.Element, AutoButtonColor = false,
        Size = UDim2.new(1, -8, 0, 30),
        Text = "",
    }, self.Content)
    new("UIPadding", {PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8)}, row)
    corner(row)

    new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(0, 6, 0, 0),
        Size = UDim2.new(1, -50, 1, 0),
        Font = FONT, TextSize = 16, TextColor3 = C.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = opts.Name or "Toggle",
    }, row)

    local bar = new("Frame", {
        Name = "ToggleFrame1",
        BackgroundColor3 = C.Disable, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -6, 0.5, 0),
        Size = UDim2.new(0, 36, 0, 18),
    }, row)
    corner(bar, 9)
    local dot = new("Frame", {
        BackgroundColor3 = C.Text, BorderSizePixel = 0,
        Position = UDim2.new(0, 2, 0.5, 0),
        AnchorPoint = Vector2.new(0, 0.5),
        Size = UDim2.new(0, 14, 0, 14),
    }, bar)
    corner(dot, 7)

    local api = {Enabled = opts.Default or false, Name = opts.Name, Object = row}
    local function setState(state, fire)
        api.Enabled = state
        bar.BackgroundColor3 = state and C.Enable or C.Disable
        TweenService:Create(dot, ANIM, {
            Position = state and UDim2.new(1, -16, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        }):Play()
        if fire and opts.Function then opts.Function(state) end
        GuiLibrary.UpdateHudEvent:Fire()
    end
    setState(api.Enabled, false)

    row.MouseButton1Click:Connect(function()
        setState(not api.Enabled, true)
        if GuiLibrary.ToggleNotifications and GuiLibrary.Notifications then
            -- sessiz geç
        end
    end)
    row.MouseEnter:Connect(function()
        row.BackgroundColor3 = C.ElementHov
        if opts.HoverText then showTooltip(opts.HoverText, row.AbsolutePosition + Vector2.new(row.AbsoluteSize.X/2, 0)) end
    end)
    row.MouseLeave:Connect(function()
        row.BackgroundColor3 = C.Element
        hideTooltip()
    end)

    GuiLibrary.ObjectsThatCanBeSaved[opts.Name] = {
        Type = "Toggle", Object = row, Api = api, SortOrder = #GuiLibrary.ObjectsThatCanBeSaved,
    }
    return api
end

-- Slider
function Window:CreateSlider(opts)
    opts = opts or {}
    local min, max = opts.Min or 0, opts.Max or 100
    local value = opts.Default or min

    local row = new("Frame", {
        Name = opts.Name .. "Slider",
        BackgroundColor3 = C.Element,
        Size = UDim2.new(1, -8, 0, 42),
    }, self.Content)
    corner(row)

    new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 4),
        Size = UDim2.new(1, -16, 0, 18),
        Font = FONT, TextSize = 15, TextColor3 = C.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = opts.Name or "Slider",
    }, row)
    local valText = new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 4),
        Size = UDim2.new(1, -16, 0, 18),
        Font = FONT, TextSize = 15, TextColor3 = C.TextDim,
        TextXAlignment = Enum.TextXAlignment.Right,
        Text = tostring(value),
    }, row)

    local slider = new("Frame", {
        Name = "Slider",
        BackgroundColor3 = C.BgDark, BorderSizePixel = 0,
        Position = UDim2.new(0, 8, 0, 28),
        Size = UDim2.new(1, -16, 0, 6),
    }, row)
    corner(slider, 3)

    local fill = new("Frame", {
        Name = "FillSlider", BackgroundColor3 = C.Accent, BorderSizePixel = 0,
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
    }, slider)
    corner(fill, 3)

    local knob = new("Frame", {
        Name = "ButtonSlider", BackgroundColor3 = C.Text, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 12, 0, 12),
    }, fill)
    corner(knob, 6)

    local api = {Value = value, Name = opts.Name, Object = row}

    local function setFromX(x)
        local rel = math.clamp((x - slider.AbsolutePosition.X) / slider.AbsoluteSize.X, 0, 1)
        local newVal = math.floor(min + (max - min) * rel + 0.5)
        if newVal ~= api.Value then
            api.Value = newVal
            fill.Size = UDim2.new(rel, 0, 1, 0)
            valText.Text = tostring(newVal)
            if opts.Function then opts.Function(newVal) end
        end
    end

    slider.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            setFromX(input.Position.X)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch)
        and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            local mp = UserInputService:GetMouseLocation()
            if mp.X >= slider.AbsolutePosition.X - 4
            and mp.X <= slider.AbsolutePosition.X + slider.AbsoluteSize.X + 4
            and mp.Y >= slider.AbsolutePosition.Y - 4
            and mp.Y <= slider.AbsolutePosition.Y + slider.AbsoluteSize.Y + 4 then
                setFromX(mp.X)
            end
        end
    end)

    GuiLibrary.ObjectsThatCanBeSaved[opts.Name] = {
        Type = "Slider", Object = row, Api = api, SortOrder = #GuiLibrary.ObjectsThatCanBeSaved,
    }
    return api
end

-- Dropdown
function Window:CreateDropdown(opts)
    opts = opts or {}
    local api = {Value = (opts.List and opts.List[1]) or "", Name = opts.Name}

    local btn = new("TextButton", {
        Name = opts.Name .. "Dropdown", BackgroundColor3 = C.Element,
        AutoButtonColor = false, Size = UDim2.new(1, -8, 0, 30), Text = "",
    }, self.Content)
    corner(btn)

    new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 0),
        Size = UDim2.new(1, -40, 1, 0),
        Font = FONT, TextSize = 15, TextColor3 = C.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = opts.Name or "Dropdown",
    }, btn)
    local valLabel = new("TextLabel", {
        BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -12, 0.5, 0),
        Size = UDim2.new(0, 90, 1, 0),
        Font = FONT, TextSize = 15, TextColor3 = C.TextDim,
        TextXAlignment = Enum.TextXAlignment.Right,
        Text = api.Value,
    }, btn)
    new("TextLabel", {
        BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -4, 0.5, 0),
        Size = UDim2.new(0, 16, 1, 0),
        Font = FONT, TextSize = 14, TextColor3 = C.TextMuted,
        Text = "v",
    }, btn)

    local list = new("Frame", {
        Name = "DropdownList", BackgroundColor3 = C.BgDark,
        BorderSizePixel = 0, Position = UDim2.new(0, 0, 1, 2),
        Size = UDim2.new(1, 0, 0, 0), Visible = false,
        ZIndex = 10, ClipsDescendants = true,
    }, btn)
    corner(list)
    local ll = new("UIListLayout", {Padding = UDim.new(0, 0),
        SortOrder = Enum.SortOrder.LayoutOrder}, list)
    new("UIPadding", {PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3)}, list)

    local function buildList()
        for _, ch in ipairs(list:GetChildren()) do
            if ch:IsA("TextButton") then ch:Destroy() end
        end
        for i, item in ipairs(opts.List or {}) do
            local it = new("TextButton", {
                BackgroundColor3 = C.BgDark, BorderSizePixel = 0,
                AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 24),
                Text = item, Font = FONT, TextSize = 14,
                TextColor3 = item == api.Value and C.Accent or C.Text,
                TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11,
            }, list)
            new("UIPadding", {PaddingLeft = UDim.new(0, 8)}, it)
            it.MouseEnter:Connect(function() it.BackgroundColor3 = C.Element end)
            it.MouseLeave:Connect(function() it.BackgroundColor3 = C.BgDark end)
            it.MouseButton1Click:Connect(function()
                api.Value = item
                valLabel.Text = item
                for _, c in ipairs(list:GetChildren()) do
                    if c:IsA("TextButton") then
                        c.TextColor3 = (c.Text == item) and C.Accent or C.Text
                    end
                end
                list.Visible = false
                if opts.Function then opts.Function(item) end
            end)
        end
        list.Size = UDim2.new(1, 0, 0, 6 + #(opts.List or {}) * 24)
    end
    buildList()

    btn.MouseButton1Click:Connect(function()
        list.Visible = not list.Visible
    end)

    GuiLibrary.ObjectsThatCanBeSaved[opts.Name] = {
        Type = "Dropdown", Object = btn, Api = api, SortOrder = #GuiLibrary.ObjectsThatCanBeSaved,
    }
    return api
end

