-- Save / Load (basit)
-- ████████████████████████████████████████████████████████████
local function safeWrite(path, data)
    if writefile then
        pcall(function() writefile(path, data) end)
    end
end
local function safeRead(path)
    if readfile and isfile and isfile(path) then
        local ok, data = pcall(readfile, path)
        return ok and data or nil
    end
    return nil
end

GuiLibrary.SaveSettings = function()
    local ok, encoded = pcall(function()
        local t = {}
        for _, obj in pairs(GuiLibrary.ObjectsThatCanBeSaved) do
            if obj.Api and obj.Api.Enabled ~= nil then
                t[obj.Api.Name or "x"] = obj.Api.Enabled
            elseif obj.Api and obj.Api.Value ~= nil then
                t[obj.Api.Name or "x"] = obj.Api.Value
            end
        end
        return game:GetService("HttpService"):JSONEncode(t)
    end)
    if ok then safeWrite(GuiLibrary.BaseDirectory.."Profiles/"..GuiLibrary.CurrentProfile..".json", encoded) end
end

GuiLibrary.LoadSettings = function(profile)
    GuiLibrary.CurrentProfile = profile or "default"
    local data = safeRead(GuiLibrary.BaseDirectory.."Profiles/"..GuiLibrary.CurrentProfile..".json")
    if not data then return end
    local ok, decoded = pcall(function() return game:GetService("HttpService"):JSONDecode(data) end)
    if not ok then return end
    for _, obj in pairs(GuiLibrary.ObjectsThatCanBeSaved) do
        local v = obj.Api and (obj.Api.Name and decoded[obj.Api.Name])
        if v ~= nil then
            if obj.Api.Enabled ~= nil then obj.Api.Enabled = v end
        end
    end
end

GuiLibrary.SwitchProfile = function(name)
    GuiLibrary.SaveSettings()
    GuiLibrary.CurrentProfile = name
    GuiLibrary.LoadSettings(name)
end

