-- UpdateUI (tema rengi)
-- ████████████████████████████████████████████████████████████
GuiLibrary.UpdateUI = function(h, s, v, bypass)
    pcall(function()
        for _, obj in pairs(GuiLibrary.ObjectsThatCanBeSaved) do
            local t = obj.Type
            local o = obj.Object
            if not o then continue end
            if t == "Toggle" and obj.Api.Enabled and o:FindFirstChild("ToggleFrame1") then
                o.ToggleFrame1.BackgroundColor3 = Color3.fromHSV(h, s, v)
            elseif t == "Slider" and o:FindFirstChild("Slider") then
                local sl = o.Slider
                if sl:FindFirstChild("FillSlider") then
                    sl.FillSlider.BackgroundColor3 = Color3.fromHSV(h, s, v)
                    if sl.FillSlider:FindFirstChild("ButtonSlider") then
                        sl.FillSlider.ButtonSlider.BackgroundColor3 = Color3.fromHSV(h, s, v)
                    end
                end
            elseif t == "Button" and obj.Api.Enabled then
                if o:FindFirstChild("ButtonText") then
                    o.ButtonText.TextColor3 = Color3.fromHSV(h, s, v)
                end
            end
        end
    end)
end

