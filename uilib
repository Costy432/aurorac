-- Divider2 → grup nesnesi (altına toggle/slider/buton koyar)
function Window:CreateDivider2(label)
    self:CreateDivider(label)
    local group = {}
    function group.CreateToggle(o) return self:CreateToggle(o) end
    function group.CreateSlider(o) return self:CreateSlider(o) end
    function group.CreateButton2(o)
        local btn = new("TextButton", {
            Name = o.Name, BackgroundColor3 = C.Element,
            AutoButtonColor = false, Size = UDim2.new(1, -8, 0, 28),
            Text = o.Name, Font = FONT, TextSize = 14,
            TextColor3 = C.Text,
        }, self.Content)
        corner(btn)
        btn.MouseEnter:Connect(function() btn.BackgroundColor3 = C.ElementHov end)
        btn.MouseLeave:Connect(function() btn.BackgroundColor3 = C.Element end)
        btn.MouseButton1Click:Connect(function() if o.Function then o.Function() end end)
        return btn
    end
    function group.CreateColorSlider(o) return self:CreateColorSlider(o) end
    return group
end

-- Renk slider (HSV)
function Window:CreateColorSlider(opts)
    if type(opts) == "string" then
        opts = {Name = opts, Function = select(2, ...) or function() end}
    end
    local api = {Hue = 0.4, Sat = 0.9, Value = 1, RainbowValue = false, Name = opts.Name}

    local row = new("Frame", {
        Name = opts.Name .. "ColorSlider",
        BackgroundColor3 = C.Element, Size = UDim2.new(1, -8, 0, 24),
    }, self.Content)
    corner(row)
    new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(0, 8, 0, 0),
        Size = UDim2.new(1, -40, 1, 0), Font = FONT, TextSize = 15,
        TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left,
        Text = opts.Name or "Color",
    }, row)
    local preview = new("Frame", {
        BackgroundColor3 = Color3.fromHSV(0.4, 0.9, 1), BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.new(0, 32, 0, 16),
    }, row)
    corner(preview)

    -- Hue slider (satır genişliği)
    local hueBar = new("Frame", {
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        Position = UDim2.new(0, 8, 0, 26), Size = UDim2.new(1, -16, 0, 10),
    }, row)
    row.Size = UDim2.new(1, -8, 0, 44)
    corner(hueBar, 3)
    new("UIGradient", {
        Color = ColorSequence.new{
            ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,0,0)),
            ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
            ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
            ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0,255,255)),
            ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)),
            ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
            ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,0,0)),
        }
    }, hueBar)
    local hueKnob = new("Frame", {
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.4, 0, 0.5, 0),
        Size = UDim2.new(0, 4, 1, 0),
    }, hueBar)

    local function apply()
        local col = Color3.fromHSV(api.Hue, api.Sat, api.Value)
        preview.BackgroundColor3 = col
        if opts.Function then opts.Function(api.Hue, api.Sat, api.Value) end
    end

    hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local rel = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
            api.Hue = rel
            hueKnob.Position = UDim2.new(rel, 0, 0.5, 0)
            apply()
        end
    end)

    api.Object = row
    GuiLibrary.ObjectsThatCanBeSaved[opts.Name] = {
        Type = "ColorSlider", Object = row, Api = api, SortOrder = #GuiLibrary.ObjectsThatCanBeSaved,
    }
    -- uyumluluk için isim tahmini
    GuiLibrary.ObjectsThatCanBeSaved["Gui ColorSliderColor"] = GuiLibrary.ObjectsThatCanBeSaved["Gui ColorSliderColor"] or {
        Type = "ColorSlider", Object = row, Api = {Hue = 0.4, Sat = 0.9, Value = 1}
    }
    return api
end

